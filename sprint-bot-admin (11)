<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sprint Bot — Admin Command Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['DM Mono', 'monospace'] },
                    colors: {
                        apex: {
                            bg: '#0b0f19',
                            panel: '#111827',
                            card: '#1f2937',
                            border: 'rgba(255,255,255,0.08)',
                            primary: '#10b981',
                            indigo: '#6366f1',
                            blue: '#3b82f6',
                            danger: '#ef4444',
                            sub: '#9ca3af'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --accent: #10b981;
            --bg: #0b0f19;
            --panel: #111827;
            --border: rgba(255, 255, 255, 0.08);
        }
        body { background-color: var(--bg); color: #f9fafb; font-family: 'Inter', sans-serif; }
        
        .panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }

        .nav-link {
            transition: all 0.2s ease;
            border-radius: 10px;
        }
        .nav-link.active {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
            font-weight: 700;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(16, 185, 129, 0.4); }

        input[type="datetime-local"]::-webkit-calendar-picker-indicator {
            filter: invert(1); opacity: 0.7; cursor: pointer;
        }
    </style>
</head>
<body class="h-screen w-screen flex overflow-hidden">

    <!-- Auth Modal -->
    <div id="auth-modal" class="fixed inset-0 bg-[#0b0f19]/98 z-[200] flex items-center justify-center p-4">
        <div class="panel p-8 w-full max-w-md border border-white/10 text-center">
            <div class="w-14 h-14 rounded-2xl bg-[#10b981]/10 text-[#10b981] border border-[#10b981]/30 flex items-center justify-center mx-auto mb-6 text-2xl">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h1 class="text-2xl font-bold mb-1">Sprint Bot Admin</h1>
            <p class="text-xs text-slate-400 mb-6">Enter your security key to access the command center</p>
            
            <input type="password" id="admin-pass" placeholder="Enter Access Key" class="w-full bg-white/5 border border-white/10 px-5 py-3.5 rounded-xl font-mono text-center text-lg tracking-[0.4em] mb-4 focus:border-[#10b981] outline-none transition-all">
            <button onclick="login()" class="w-full py-3.5 bg-[#10b981] hover:bg-[#059669] text-white font-bold rounded-xl transition-all shadow-lg shadow-[#10b981]/20">Login to Command Center</button>
        </div>
    </div>

    <!-- Main Dashboard Application -->
    <div id="app" class="hidden flex-1 flex flex-col md:flex-row overflow-hidden relative w-full">
        
        <!-- Sidebar Navigation -->
        <aside id="sidebar" class="w-64 bg-[#111827] border-r border-white/10 flex flex-col shrink-0 p-5 overflow-y-auto">
            <div class="flex items-center gap-3 mb-8 px-2">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#10b981] to-[#6366f1] p-0.5 shadow-md shrink-0">
                    <div class="w-full h-full rounded-xl bg-[#0b0f19] flex items-center justify-center text-[#10b981] font-bold text-lg">
                        <i class="fas fa-robot"></i>
                    </div>
                </div>
                <div>
                    <h2 class="font-bold text-base leading-tight">Sprint Bot</h2>
                    <span class="text-[10px] text-[#10b981] font-semibold tracking-wider uppercase bg-[#10b981]/10 px-2 py-0.5 rounded border border-[#10b981]/20">Command Center v5.0</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="space-y-1 mb-6">
                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-3 mb-2">Core Modules</div>
                <button onclick="switchTab('overview')" id="nav-overview" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-chart-pie text-xs w-4"></i> Overview & Status</button>
                <button onclick="switchTab('writers')" id="nav-writers" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-users-gear text-xs w-4"></i> Writers & PIN Access</button>
                <button onclick="switchTab('analytics')" id="nav-analytics" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-chart-line text-xs w-4"></i> Performance Analytics</button>
            </div>

            <div class="space-y-1 mb-6">
                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-3 mb-2">Management</div>
                <button onclick="switchTab('sprints')" id="nav-sprints" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-stopwatch text-xs w-4"></i> Active Sprints</button>
                <button onclick="switchTab('groups')" id="nav-groups" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-comments text-xs w-4"></i> WhatsApp Groups</button>
                <button onclick="switchTab('scheduler')" id="nav-scheduler" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-bullhorn text-xs w-4"></i> Broadcast & Schedule</button>
                <button onclick="switchTab('feedback')" id="nav-feedback" class="nav-link w-full flex items-center justify-between px-4 py-2.5 text-sm text-slate-300 hover:text-white transition">
                    <span class="flex items-center gap-3"><i class="fas fa-inbox text-xs w-4"></i> Feedback</span>
                    <span id="unread-count" class="hidden text-[10px] font-bold bg-[#ef4444] text-white px-2 py-0.5 rounded-full">0</span>
                </button>
            </div>

            <div class="mt-auto pt-4 border-t border-white/10 space-y-2">
                <button onclick="logout()" class="w-full py-2 text-slate-400 hover:text-red-400 text-xs font-semibold text-left px-3 transition flex items-center gap-2">
                    <i class="fas fa-arrow-right-from-bracket"></i> Sign Out
                </button>
            </div>
        </aside>

        <!-- Main Content View Area -->
        <main class="flex-1 flex flex-col overflow-hidden relative bg-[#0b0f19]">
            
            <!-- Top App Bar -->
            <header class="h-16 border-b border-white/10 flex items-center justify-between px-6 shrink-0 bg-[#111827]">
                <div class="flex items-center gap-3">
                    <h2 id="view-title" class="font-bold text-lg text-white">Overview</h2>
                    <span id="conn-badge" class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Connected
                    </span>
                </div>
                
                <div class="flex items-center gap-3">
                    <button onclick="refreshData()" title="Refresh Dashboard" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 hover:bg-white/10 text-slate-300 flex items-center justify-center transition">
                        <i class="fas fa-sync-alt text-xs"></i>
                    </button>
                </div>
            </header>

            <!-- Tab Content Views -->
            <div class="flex-1 overflow-y-auto p-6 space-y-6">
                
                <!-- VIEW 1: OVERVIEW -->
                <div id="view-overview" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="panel p-5">
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">WhatsApp Connection</div>
                            <div id="conn-display" class="flex items-center gap-3">
                                <i class="fas fa-circle-check text-emerald-400 text-2xl"></i>
                                <span class="font-bold text-sm text-slate-200">Online & Ready</span>
                            </div>
                        </div>
                        <div class="panel p-5">
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Server Memory</div>
                            <div id="sys-mem" class="text-2xl font-bold font-mono text-indigo-400">...</div>
                        </div>
                        <div class="panel p-5">
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Server Uptime</div>
                            <div id="sys-uptime" class="text-xl font-bold font-mono text-emerald-400">...</div>
                        </div>
                        <div class="panel p-5">
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Active Sprints</div>
                            <div id="sys-sprints-count" class="text-2xl font-bold font-mono text-amber-400">0</div>
                        </div>
                    </div>

                    <!-- Global Maintenance Panel -->
                    <div class="panel p-5 flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/30 flex items-center justify-center text-lg">
                                <i class="fas fa-wrench"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-sm">Maintenance Mode</h3>
                                <p class="text-xs text-slate-400">Locks bot commands for all non-admin users</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span id="maint-status" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-slate-400 border border-slate-700">Inactive</span>
                            <button onclick="toggleMaintenance()" id="maint-btn" class="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-bold transition">Activate</button>
                        </div>
                    </div>

                    <!-- Activity Log -->
                    <div class="panel p-5">
                        <h3 class="text-sm font-bold mb-4 text-slate-200">System Activity Stream</h3>
                        <div id="sys-log" class="space-y-2 max-h-[350px] overflow-y-auto font-mono text-xs text-slate-300"></div>
                    </div>
                </div>

                <!-- VIEW 2: WRITERS & PIN ACCESS (TOTAL REVAMP) -->
                <div id="view-writers" class="hidden space-y-6">
                    
                    <!-- Quick PIN Lookup Header Card -->
                    <div class="panel p-6 bg-gradient-to-r from-[#111827] to-[#1f2937] border-emerald-500/30 relative overflow-hidden">
                        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                            <div>
                                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                    <i class="fas fa-key text-emerald-400"></i> Quick Writer PIN Lookup
                                </h3>
                                <p class="text-xs text-slate-400 mt-1">Search any writer's phone or name to view or issue their 4-digit web logging PIN</p>
                            </div>

                            <div class="flex items-center gap-2 w-full md:w-auto">
                                <input type="text" id="quick-pin-search" oninput="quickPinLookup(this.value)" placeholder="Enter phone or name..." class="bg-black/30 border border-white/15 px-4 py-2.5 rounded-xl text-xs w-full md:w-64 outline-none focus:border-emerald-400">
                            </div>
                        </div>

                        <!-- Quick Result Display Box -->
                        <div id="quick-pin-result" class="hidden mt-4 pt-4 border-t border-white/10 flex items-center justify-between bg-black/40 p-4 rounded-xl">
                            <div class="flex items-center gap-3">
                                <div id="qp-avatar" class="w-10 h-10 rounded-lg bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center text-sm"></div>
                                <div>
                                    <div id="qp-name" class="font-bold text-sm"></div>
                                    <div id="qp-phone" class="text-xs text-slate-400 font-mono"></div>
                                </div>
                            </div>
                            
                            <div class="flex items-center gap-4">
                                <div class="text-right">
                                    <div class="text-[10px] text-slate-400 uppercase font-bold">4-Digit Web PIN</div>
                                    <div id="qp-pin" class="text-2xl font-bold font-mono text-emerald-400 tracking-widest"></div>
                                </div>
                                <button onclick="copyQuickPin()" class="px-3 py-2 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/30 rounded-lg text-xs font-bold transition flex items-center gap-1.5">
                                    <i class="fas fa-copy"></i> Copy PIN
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Writers Data Table & Controls -->
                    <div class="panel p-5 space-y-4">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                            <div class="flex items-center gap-2 w-full sm:w-auto">
                                <input type="text" id="writer-search" oninput="loadWritersGrid()" placeholder="Search writers..." class="bg-white/5 border border-white/10 px-4 py-2 rounded-xl text-xs w-full sm:w-64 outline-none focus:border-emerald-400">
                                
                                <select id="writer-filter" onchange="loadWritersGrid()" class="bg-[#1f2937] border border-white/10 px-3 py-2 rounded-xl text-xs outline-none">
                                    <option value="all">All Writers</option>
                                    <option value="active">Active Only</option>
                                    <option value="inactive">Inactive</option>
                                    <option value="archived">Archived</option>
                                    <option value="banned">Banned</option>
                                </select>
                            </div>

                            <div class="text-xs text-slate-400 font-medium">
                                Total: <span id="writers-count" class="font-bold text-white">0</span> writers
                            </div>
                        </div>

                        <!-- Main Writers Table -->
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="border-b border-white/10 text-slate-400 uppercase text-[10px] tracking-wider font-bold">
                                        <th class="py-3 px-4">Writer</th>
                                        <th class="py-3 px-4">Phone ID</th>
                                        <th class="py-3 px-4">Rank & Words</th>
                                        <th class="py-3 px-4">Streak</th>
                                        <th class="py-3 px-4">Web PIN</th>
                                        <th class="py-3 px-4">Status</th>
                                        <th class="py-3 px-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="writers-table-body" class="divide-y divide-white/5 font-medium">
                                    <!-- Populated dynamically -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- VIEW 3: ANALYTICS -->
                <div id="view-analytics" class="hidden space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="panel p-5 text-center">
                            <div class="text-xs font-bold text-slate-400 uppercase">Retention Rate</div>
                            <div id="ana-retention" class="text-3xl font-bold text-emerald-400 mt-2">0%</div>
                        </div>
                        <div class="panel p-5 text-center">
                            <div class="text-xs font-bold text-slate-400 uppercase">Active Writers</div>
                            <div id="ana-active-current" class="text-3xl font-bold text-indigo-400 mt-2">0</div>
                        </div>
                        <div class="panel p-5 text-center">
                            <div class="text-xs font-bold text-slate-400 uppercase">Total Logged Words</div>
                            <div id="ana-total-words" class="text-3xl font-bold text-blue-400 mt-2">0</div>
                        </div>
                    </div>

                    <div class="panel p-5">
                        <h3 class="text-sm font-bold mb-4">Writing Velocity</h3>
                        <div class="h-64"><canvas id="chart-velocity"></canvas></div>
                    </div>
                </div>

                <!-- VIEW 4: SPRINTS -->
                <div id="view-sprints" class="hidden space-y-6">
                    <div class="panel p-5">
                        <h3 class="text-sm font-bold mb-4">Active Sprints Across Groups</h3>
                        <div id="active-sprints-list" class="space-y-3"></div>
                    </div>
                </div>

                <!-- VIEW 5: GROUPS -->
                <div id="view-groups" class="hidden space-y-6">
                    <div class="panel p-5">
                        <h3 class="text-sm font-bold mb-4">Managed WhatsApp Groups</h3>
                        <div id="groups-list" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
                    </div>
                </div>

                <!-- VIEW 6: SCHEDULER -->
                <div id="view-scheduler" class="hidden space-y-6">
                    <div class="panel p-5">
                        <h3 class="text-sm font-bold mb-4">Scheduled Broadcasts</h3>
                        <div id="scheduled-list" class="space-y-3"></div>
                    </div>
                </div>

                <!-- VIEW 7: FEEDBACK -->
                <div id="view-feedback" class="hidden space-y-6">
                    <div class="panel p-5">
                        <h3 class="text-sm font-bold mb-4">Writer Feedback Inbox</h3>
                        <div id="feedback-list" class="space-y-3"></div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Edit Writer Drawer Modal -->
    <div id="writer-edit-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[200] hidden flex items-center justify-center p-4">
        <div class="panel p-6 max-w-md w-full relative">
            <button onclick="closeWriterEditModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i class="fas fa-times"></i></button>
            <h3 class="text-lg font-bold mb-4">Edit Writer Profile</h3>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Writer Name</label>
                    <input type="text" id="edit-w-name" class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-400">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Current Streak (Days)</label>
                    <input type="number" id="edit-w-streak" class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-400">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Web Logging 4-Digit PIN</label>
                    <div class="flex gap-2">
                        <input type="text" id="edit-w-pin" maxlength="4" class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-sm font-mono tracking-widest text-center outline-none focus:border-emerald-400">
                        <button onclick="generateEditPin()" class="px-3 py-2 bg-white/10 hover:bg-white/20 rounded-xl text-xs font-bold transition">🎲 Random</button>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex justify-end gap-2">
                <button onclick="closeWriterEditModal()" class="px-4 py-2 bg-white/5 hover:bg-white/10 rounded-xl text-xs font-bold transition">Cancel</button>
                <button onclick="saveWriterEdit()" class="px-5 py-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl text-xs transition">Save Changes</button>
            </div>
        </div>
    </div>

    <!-- Script Application Logic -->
    <script>
        let adminPass = localStorage.getItem('admin_pass') || '';
        let currentTab = 'overview';
        let writersCache = [];
        let editingUserId = null;
        let revealedPins = new Set();

        async function api(endpoint, body = null) {
            const options = {
                method: body ? 'POST' : 'GET',
                headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPass }
            };
            if (body) options.body = JSON.stringify(body);
            try {
                const res = await fetch(endpoint, options);
                if (res.status === 403) { logout(); return null; }
                return await res.json();
            } catch (e) {
                console.error("API error:", e);
                return null;
            }
        }

        async function login() {
            adminPass = document.getElementById('admin-pass').value.trim();
            if (!adminPass) return alert("Please enter the access key");
            const res = await api('/api/admin/system');
            if (res && !res.error) {
                localStorage.setItem('admin_pass', adminPass);
                document.getElementById('auth-modal').classList.add('hidden');
                document.getElementById('app').classList.remove('hidden');
                switchTab('overview');
            } else {
                alert("Invalid Access Key");
            }
        }

        function logout() {
            localStorage.removeItem('admin_pass');
            adminPass = '';
            document.getElementById('app').classList.add('hidden');
            document.getElementById('auth-modal').classList.remove('hidden');
        }

        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('active'));
            const navEl = document.getElementById('nav-' + tab);
            if (navEl) navEl.classList.add('active');

            document.querySelectorAll('[id^="view-"]').forEach(el => el.classList.add('hidden'));
            const viewEl = document.getElementById('view-' + tab);
            if (viewEl) viewEl.classList.remove('hidden');

            document.getElementById('view-title').innerText = tab.charAt(0).toUpperCase() + tab.slice(1);
            refreshData();
        }

        async function refreshData() {
            if (currentTab === 'overview') loadOverview();
            else if (currentTab === 'writers') loadWritersGrid();
            else if (currentTab === 'analytics') loadAnalytics();
            else if (currentTab === 'sprints') loadSprints();
            else if (currentTab === 'feedback') loadFeedback();
        }

        async function loadOverview() {
            const sys = await api('/api/admin/system');
            if (sys) {
                document.getElementById('sys-mem').innerText = sys.memory + " MB";
                document.getElementById('sys-uptime').innerText = Math.floor(sys.uptime / 3600) + "h " + Math.floor((sys.uptime % 3600)/60) + "m";
                document.getElementById('sys-sprints-count').innerText = sys.activeSprintsCount || 0;
                
                const maintBtn = document.getElementById('maint-btn');
                const maintStatus = document.getElementById('maint-status');
                if (sys.maintenance) {
                    maintStatus.innerText = "ACTIVE";
                    maintStatus.className = "text-xs font-bold px-3 py-1 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30";
                    maintBtn.innerText = "Deactivate";
                } else {
                    maintStatus.innerText = "Inactive";
                    maintStatus.className = "text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-slate-400 border border-slate-700";
                    maintBtn.innerText = "Activate";
                }

                if (sys.recentActivity) {
                    document.getElementById('sys-log').innerHTML = sys.recentActivity.map(a => `<div><span class="text-slate-500">[${new Date(a.time).toLocaleTimeString()}]</span> ${a.text}</div>`).join('');
                }
            }
        }

        async function toggleMaintenance() {
            const status = document.getElementById('maint-status').innerText !== "ACTIVE";
            await api('/api/admin/maintenance', { status });
            loadOverview();
        }

        async function loadWritersGrid() {
            const query = document.getElementById('writer-search').value;
            const filter = document.getElementById('writer-filter').value;
            const data = await api('/api/admin/search', { query });
            writersCache = data || [];
            document.getElementById('writers-count').innerText = writersCache.length;

            let list = [...writersCache];
            if (filter === 'active') list = list.filter(u => !u.isArchived && !u.isInactive && !u.isBanned);
            else if (filter === 'inactive') list = list.filter(u => u.isInactive);
            else if (filter === 'archived') list = list.filter(u => u.isArchived);
            else if (filter === 'banned') list = list.filter(u => u.isBanned);

            const tbody = document.getElementById('writers-table-body');
            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-500">No writers found matching search criteria.</td></tr>`;
                return;
            }

            tbody.innerHTML = list.map(u => {
                const isRevealed = revealedPins.has(u._id);
                const pinDisplay = isRevealed ? (u.webPin || '----') : '••••';
                let statusBadge = `<span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">Active</span>`;
                if (u.isBanned) statusBadge = `<span class="px-2 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20 text-[10px]">Banned</span>`;
                else if (u.isArchived) statusBadge = `<span class="px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20 text-[10px]">Archived</span>`;
                else if (u.isInactive) statusBadge = `<span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 text-[10px]">Inactive</span>`;

                return `
                    <tr class="hover:bg-white/5 transition">
                        <td class="py-3 px-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center text-xs">
                                    ${u.name.charAt(0).toUpperCase()}
                                </div>
                                <div class="font-bold text-white">${u.name}</div>
                            </div>
                        </td>
                        <td class="py-3 px-4 font-mono text-slate-400">${u._id.split('@')[0]}</td>
                        <td class="py-3 px-4">
                            <div class="font-bold text-white font-mono">${(u.totalWords || 0).toLocaleString()}</div>
                            <div class="text-[10px] text-emerald-400">${u.rank || 'Novice'}</div>
                        </td>
                        <td class="py-3 px-4 font-mono font-bold text-amber-400">${u.streak || 0}🔥</td>
                        <td class="py-3 px-4 font-mono">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-emerald-400 tracking-wider">${pinDisplay}</span>
                                <button onclick="togglePinReveal('${u._id}')" class="text-slate-400 hover:text-white p-1" title="Show/Hide PIN">
                                    <i class="fas ${isRevealed ? 'fa-eye-slash' : 'fa-eye'}"></i>
                                </button>
                                <button onclick="resetUserPin('${u._id}')" class="text-slate-400 hover:text-emerald-400 p-1" title="Generate New PIN">
                                    <i class="fas fa-dice"></i>
                                </button>
                            </div>
                        </td>
                        <td class="py-3 px-4">${statusBadge}</td>
                        <td class="py-3 px-4 text-right space-x-2">
                            <button onclick="openWriterEditModal('${u._id}')" class="px-2.5 py-1 bg-white/5 hover:bg-white/10 rounded-lg text-slate-300 transition" title="Edit Writer">
                                <i class="fas fa-pen"></i>
                            </button>
                            <button onclick="toggleWriterBan('${u._id}', ${!u.isBanned})" class="px-2.5 py-1 ${u.isBanned ? 'bg-emerald-500/20 text-emerald-400' : 'bg-red-500/20 text-red-400'} rounded-lg transition" title="${u.isBanned ? 'Unban Writer' : 'Ban Writer'}">
                                <i class="fas ${u.isBanned ? 'fa-user-check' : 'fa-user-slash'}"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function togglePinReveal(userId) {
            if (revealedPins.has(userId)) revealedPins.delete(userId);
            else revealedPins.add(userId);
            loadWritersGrid();
        }

        async function resetUserPin(userId) {
            const res = await api('/api/admin/user/set-pin', { userId });
            if (res?.success) {
                revealedPins.add(userId);
                alert(`New PIN generated for ${userId.split('@')[0]}: ${res.webPin}`);
                loadWritersGrid();
            }
        }

        function quickPinLookup(val) {
            const q = val.trim().toLowerCase();
            const resBox = document.getElementById('quick-pin-result');
            if (!q) { resBox.classList.add('hidden'); return; }
            
            const match = writersCache.find(u => u.name.toLowerCase().includes(q) || u._id.includes(q));
            if (match) {
                document.getElementById('qp-avatar').innerText = match.name.charAt(0).toUpperCase();
                document.getElementById('qp-name').innerText = match.name;
                document.getElementById('qp-phone').innerText = match._id.split('@')[0];
                document.getElementById('qp-pin').innerText = match.webPin || '----';
                resBox.classList.remove('hidden');
            } else {
                resBox.classList.add('hidden');
            }
        }

        function copyQuickPin() {
            const pin = document.getElementById('qp-pin').innerText;
            navigator.clipboard.writeText(pin);
            alert("PIN copied to clipboard: " + pin);
        }

        function openWriterEditModal(userId) {
            editingUserId = userId;
            const u = writersCache.find(x => x._id === userId);
            if (!u) return;
            document.getElementById('edit-w-name').value = u.name;
            document.getElementById('edit-w-streak').value = u.streak || 0;
            document.getElementById('edit-w-pin').value = u.webPin || '';
            document.getElementById('writer-edit-modal').classList.remove('hidden');
        }

        function closeWriterEditModal() {
            document.getElementById('writer-edit-modal').classList.add('hidden');
        }

        function generateEditPin() {
            document.getElementById('edit-w-pin').value = Math.floor(1000 + Math.random() * 9000).toString();
        }

        async function saveWriterEdit() {
            if (!editingUserId) return;
            const name = document.getElementById('edit-w-name').value.trim();
            const streak = parseInt(document.getElementById('edit-w-streak').value, 10);
            const pin = document.getElementById('edit-w-pin').value.trim();

            if (name) await api('/api/admin/update', { userId: editingUserId, type: 'name', name });
            if (!isNaN(streak)) await api('/api/admin/update', { userId: editingUserId, type: 'streak', currentStreak: streak, bestStreak: streak });
            if (pin && pin.length === 4) await api('/api/admin/user/set-pin', { userId: editingUserId, pin });

            closeWriterEditModal();
            loadWritersGrid();
        }

        async function toggleWriterBan(userId, isBanning) {
            if (confirm(`Are you sure you want to ${isBanning ? 'BAN' : 'UNBAN'} this writer?`)) {
                await api('/api/admin/ban', { userId, action: isBanning ? 'ban' : 'unban' });
                loadWritersGrid();
            }
        }

        async function loadAnalytics() {
            const stats = await api('/api/stats');
            if (stats) {
                document.getElementById('ana-total-words').innerText = (stats.totalWords || 0).toLocaleString();
                document.getElementById('ana-active-current').innerText = stats.totalWriters || 0;
            }
        }

        async function loadSprints() {
            const sprints = await api('/api/admin/sprints');
            const list = document.getElementById('active-sprints-list');
            if (!sprints || sprints.length === 0) {
                list.innerHTML = `<div class="text-center py-6 text-slate-500 text-xs">No active sprints right now.</div>`;
                return;
            }
            list.innerHTML = sprints.map(s => `
                <div class="flex items-center justify-between p-4 bg-white/5 rounded-xl">
                    <div>
                        <div class="font-bold text-sm text-white">${s.name}</div>
                        <div class="text-xs text-slate-400">${s.participants} participants • ${s.timeLeft}m remaining</div>
                    </div>
                    <button onclick="stopSprint('${s.id}')" class="px-3 py-1.5 bg-red-500/20 text-red-400 rounded-lg text-xs font-bold hover:bg-red-500/30 transition">Stop Sprint</button>
                </div>
            `).join('');
        }

        async function stopSprint(chatId) {
            if (confirm("Stop this sprint?")) {
                await api('/api/admin/sprints/stop', { chatId });
                loadSprints();
            }
        }

        async function loadFeedback() {
            const sys = await api('/api/admin/system');
            if (sys && sys.unreadFeedback) {
                const unreadEl = document.getElementById('unread-count');
                unreadEl.innerText = sys.unreadFeedback;
                unreadEl.classList.remove('hidden');
            }
        }

        // Auto Login check
        if (adminPass) {
            document.getElementById('admin-pass').value = adminPass;
            login();
        }
    </script>

</body>
</html>