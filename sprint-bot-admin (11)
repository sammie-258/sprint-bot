            const container = document.getElementById('groups-grid');
            container.innerHTML = '';
            if (!groups || groups.length === 0) { container.innerHTML = '<div class="col-span-full text-center py-10 font-bold opacity-50">No connected groups found.</div>'; return; }
            
            const healthColors = { 
                Active: 'text-[#10b981]', 
                Quiet: 'text-yellow-500', 
                Dormant: 'opacity-40 text-bold' 
            };

            groups.forEach(g => {
                const hColor = healthColors[g.health] || healthColors.Dormant;
                
                container.innerHTML += `
                    <div class="panel p-6 flex flex-col justify-between group h-full">
                        <div>
                            <div class="flex justify-between items-start mb-6">
                                <div class="w-12 h-12 rounded-2xl panel-inset text-indigo-500 flex items-center justify-center text-xl shrink-0"><i class="fas fa-hashtag"></i></div>
                                <div class="flex items-center gap-3">
                                    <span class="text-[10px] font-black uppercase tracking-widest ${hColor}">${g.health || 'Dormant'}</span>
                                    <button onclick="leaveGroup('${g.id}')" class="btn-clay w-8 h-8 rounded-full flex items-center justify-center text-red-500 opacity-0 group-hover:opacity-100 transition" title="Leave Group"><i class="fas fa-sign-out-alt"></i></button>
                                </div>
                            </div>
                            <h3 class="font-extrabold text-xl text-bold mb-6 truncate" title="${g.name}">${g.name}</h3>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="panel-inset p-3 text-center rounded-xl">
                                <p class="text-[9px] font-bold uppercase tracking-widest opacity-50 mb-1">Members</p>
                                <p class="font-black text-bold text-lg">${g.participants || 0}</p>
                            </div>
                            <div class="panel-inset p-3 text-center rounded-xl">
                                <p class="text-[9px] font-bold uppercase tracking-widest opacity-50 mb-1">Active</p>
                                <p class="font-black text-[#10b981] text-lg">${g.activeWritersToday || 0}</p>
                            </div>
                            <div class="panel-inset p-3 text-center rounded-xl col-span-2">
                                <p class="text-[9px] font-bold uppercase tracking-widest opacity-50 mb-1">Words This Week</p>
                                <p class="font-black text-blue-500 text-lg">${(g.weekWords || 0).toLocaleString()}</p>
                            </div>
                        </div>
                    </div>`;
            });
        }
        async function leaveGroup(chatId) { showConfirm("The bot will leave this group permanently.", async () => { await api('/api/admin/groups/leave', { chatId }); showToast("Bot left the group"); loadGroups(); }); }
        
        // --- Join Group ---
        function openJoinGroup() {
            document.getElementById('join-group-modal').classList.remove('hidden');
            document.getElementById('invite-code-input').value = '';
            document.getElementById('join-error').classList.add('hidden'); document.getElementById('join-result').classList.add('hidden');
            document.getElementById('join-btn').disabled = false; document.getElementById('join-btn').innerHTML = '<i class="fab fa-whatsapp mr-2"></i> Join';
            setTimeout(() => document.getElementById('invite-code-input').focus(), 100);
        }
        function closeJoinGroup() { document.getElementById('join-group-modal').classList.add('hidden'); }
        async function joinGroup() {
            const inviteCode = document.getElementById('invite-code-input').value.trim();
            const errorEl = document.getElementById('join-error');
            const resultEl = document.getElementById('join-result'); const btn = document.getElementById('join-btn');
            errorEl.classList.add('hidden'); resultEl.classList.add('hidden');
            
            if (!inviteCode) { errorEl.textContent = 'Paste an invite link or code.'; errorEl.classList.remove('hidden'); return; }
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
            const res = await api('/api/admin/groups/accept', { inviteCode });
            btn.disabled = false;
            btn.innerHTML = '<i class="fab fa-whatsapp mr-2"></i> Join';
            
            if (!res) { errorEl.textContent = 'Request failed. Check connection.'; errorEl.classList.remove('hidden'); return; }
            if (res.success) {
                resultEl.classList.remove('hidden');
                document.getElementById('invite-code-input').value = ''; showToast("Bot joined the group!");
                setTimeout(() => { loadGroups(); closeJoinGroup(); }, 2000);
            } else { 
                errorEl.textContent = res.error || 'Failed to join. Invalid link.'; 
                errorEl.classList.remove('hidden');
            }
        }

        // --- Sprints ---
        async function loadSprints() {
            const containerActive = document.getElementById('sprints-list');
            try {
                const activeData = await api('/api/admin/sprints', null, 'GET');
                containerActive.innerHTML = '';
                if (!activeData || !Array.isArray(activeData) || activeData.length === 0) {
                    containerActive.innerHTML = '<div class="col-span-full py-16 panel-inset flex justify-center items-center text-center font-bold opacity-40">No active sprints right now.</div>';
                } else {
                    activeData.forEach(s => {
                        const pList = Array.isArray(s.participantList) ? s.participantList : [];
                        const partsList = pList.map(p => `<span class="inline-block panel-inset font-bold text-[10px] px-3 py-1.5 rounded-lg mr-2 mb-2">@${p.uid} <span class="text-emerald-500 ml-1">${p.words}</span></span>`).join('');
                        
                        containerActive.innerHTML += `
                        <div class="panel p-6 flex flex-col justify-between">
                            <div class="flex justify-between items-start mb-5">
                                <h3 class="font-extrabold text-xl text-bold truncate pr-4">${s.name}</h3>
                                <button onclick="stopSprint('${s.id}')" class="btn-clay-danger px-4 py-2 rounded-xl text-xs shrink-0"><i class="fas fa-stop"></i></button>
                            </div>
                            <div class="flex items-center gap-4 mb-6">
                                <div class="panel-inset px-4 py-2 rounded-xl flex items-center gap-2">
                                    <i class="fas fa-stopwatch text-emerald-500 animate-pulse text-lg"></i>
                                    <span class="font-black text-bold">${s.timeLeft}m</span>
                                </div>
                                <div class="panel-inset px-4 py-2 rounded-xl flex items-center gap-2">
                                    <i class="fas fa-users text-blue-500 text-lg"></i>
                                    <span class="font-black text-bold">${s.participants}</span>
                                </div>
                            </div>
                            <div class="pt-5 border-t border-black/5 dark:border-white/5 min-h-[4rem]">
                                ${pList.length ? partsList : '<span class="text-xs font-bold opacity-40">No words logged yet...</span>'}
                            </div>
                        </div>`;
                    });
                }
            } catch(e) { containerActive.innerHTML = '<div class="col-span-full text-center py-10 font-bold text-red-500">Error loading sprints.</div>'; }
        }
        async function stopSprint(chatId) { showConfirm("Stop this sprint immediately?", async () => { await api('/api/admin/sprints/stop', { chatId }); showToast("Sprint stopped"); loadSprints(); }); }

        // --- Instant Broadcast ---
        function openBroadcast() { document.getElementById('broadcast-modal').classList.remove('hidden'); }
        function handleBroadcastImage() {
            const file = document.getElementById('broadcast-file').files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    broadcastImageBase64 = e.target.result;
                    document.getElementById('broadcast-preview').src = broadcastImageBase64;
                    document.getElementById('broadcast-preview-container').classList.remove('hidden'); document.getElementById('img-label-text').innerText = "Change Image";
                }; reader.readAsDataURL(file);
            }
        }
        function removeBroadcastImage() {
            broadcastImageBase64 = null;
            document.getElementById('broadcast-file').value = "";
            document.getElementById('broadcast-preview-container').classList.add('hidden'); document.getElementById('img-label-text').innerText = "Add Image";
        }
        async function sendBroadcast() {
            const msg = document.getElementById('broadcast-text').value;
            if (!msg && !broadcastImageBase64) return showToast("Enter text or image", "error");
            showConfirm("Send this to ALL groups instantly?", async () => {
                const res = await api('/api/admin/broadcast', { message: msg, image: broadcastImageBase64 });
                if (res && res.success) {
                    showToast(`Sent to ${res.count} groups!`); document.getElementById('broadcast-modal').classList.add('hidden');
                    document.getElementById('broadcast-text').value = ""; removeBroadcastImage();
                } else { showToast("Failed to send", "error"); }
            });
        }

        // --- Utils ---
        function animateValue(id, end) {
            const obj = document.getElementById(id);
            if (!obj) return;
            const current = parseInt(obj.innerText.replace(/,/g, '').replace('M','000000').replace('k','000')) || 0; if (current === end) return;
            let start = null;
            const duration = 1000;
            const step = ts => {
                if (!start) start = ts;
                const prog = Math.min((ts - start) / duration, 1);
                obj.innerHTML = Math.floor(prog * (end - current) + current).toLocaleString();
                if (prog < 1) window.requestAnimationFrame(step); else obj.innerHTML = end.toLocaleString();
            }; window.requestAnimationFrame(step);
        }
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const baseClass = type === 'success' ? 'bg-[#10b981]' : type === 'error' ? 'bg-red-500' : 'bg-slate-800';
            const icon = type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle';
            
            toast.className = `pointer-events-auto flex items-center gap-4 px-6 py-4 rounded-2xl shadow-[5px_5px_15px_rgba(0,0,0,0.2)] transform transition-all duration-400 translate-x-full opacity-0 ${baseClass} text-white font-bold`;
            toast.innerHTML = `<i class="fas ${icon} text-2xl drop-shadow-md"></i><span>${message}</span>`;
            container.appendChild(toast);
            
            requestAnimationFrame(() => { toast.classList.remove('translate-x-full', 'opacity-0'); });
            setTimeout(() => { toast.classList.add('translate-x-full', 'opacity-0'); setTimeout(() => toast.remove(), 400); }, 3000);
        }
        function showConfirm(message, callback) {
            document.getElementById('confirm-msg').innerText = message;
            document.getElementById('confirm-modal').classList.remove('hidden');
            const yesBtn = document.getElementById('confirm-yes-btn'); const newBtn = yesBtn.cloneNode(true); yesBtn.parentNode.replaceChild(newBtn, yesBtn);
            newBtn.addEventListener('click', () => { callback(); closeConfirm(); });
        }
        function closeConfirm() { document.getElementById('confirm-modal').classList.add('hidden'); }
    </script>
</body>
</html>