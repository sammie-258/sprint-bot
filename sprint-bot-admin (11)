<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sprint Bot — Admin Command Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['DM Mono', 'monospace'] },
                    colors: {
                        apex: {
                            bg: '#0b0f19',
                            panel: '#111827',
                            card: '#1f2937',
                            border: 'rgba(255,255,255,0.08)',
                            primary: '#10b981',
                            indigo: '#6366f1',
                            blue: '#3b82f6',
                            danger: '#ef4444',
                            sub: '#9ca3af'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --accent: #10b981;
            --bg: #0b0f19;
            --panel: #111827;
            --border: rgba(255, 255, 255, 0.08);
        }
        body { background-color: var(--bg); color: #f9fafb; font-family: 'Inter', sans-serif; overflow-x: hidden; }
        
        .panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }

        .nav-link {
            transition: all 0.2s ease;
            border-radius: 10px;
        }
        .nav-link.active {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
            font-weight: 700;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(16, 185, 129, 0.4); }

        input[type="datetime-local"]::-webkit-calendar-picker-indicator {
            filter: invert(1); opacity: 0.7; cursor: pointer;
        }
    </style>
</head>
<body class="h-screen w-screen flex overflow-hidden">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-[300] space-y-2 pointer-events-none"></div>

    <!-- Custom Confirmation Modal -->
    <div id="confirm-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[280] hidden flex items-center justify-center p-4">
        <div class="panel p-6 max-w-sm w-full border border-white/10 text-center space-y-4">
            <div class="w-12 h-12 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30 flex items-center justify-center mx-auto text-xl">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
            <h3 id="confirm-title" class="font-bold text-base text-white">Confirmation</h3>
            <p id="confirm-msg" class="text-xs text-slate-400"></p>
            <div class="flex gap-3 pt-2">
                <button onclick="closeConfirmModal(false)" class="flex-1 py-2.5 bg-white/5 hover:bg-white/10 rounded-xl text-xs font-bold transition">Cancel</button>
                <button id="confirm-ok-btn" onclick="closeConfirmModal(true)" class="flex-1 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl text-xs font-bold transition">Confirm</button>
            </div>
        </div>
    </div>

    <!-- Custom Prompt Input Modal -->
    <div id="prompt-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[280] hidden flex items-center justify-center p-4">
        <div class="panel p-6 max-w-sm w-full border border-white/10 text-center space-y-4">
            <div class="w-12 h-12 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/30 flex items-center justify-center mx-auto text-xl">
                <i class="fas fa-pen-to-square"></i>
            </div>
            <h3 id="prompt-title" class="font-bold text-base text-white">Enter Value</h3>
            <input type="text" id="prompt-input" class="w-full bg-black/40 border border-white/15 px-4 py-2.5 rounded-xl text-xs font-mono text-center outline-none focus:border-indigo-400">
            <div class="flex gap-3 pt-2">
                <button onclick="closePromptModal(null)" class="flex-1 py-2.5 bg-white/5 hover:bg-white/10 rounded-xl text-xs font-bold transition">Cancel</button>
                <button onclick="closePromptModal(document.getElementById('prompt-input').value)" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition">Submit</button>
            </div>
        </div>
    </div>

    <!-- Auth Modal -->
    <div id="auth-modal" class="fixed inset-0 bg-[#0b0f19]/98 z-[200] flex items-center justify-center p-4">
        <div class="panel p-8 w-full max-w-md border border-white/10 text-center">
            <div class="w-14 h-14 rounded-2xl bg-[#10b981]/10 text-[#10b981] border border-[#10b981]/30 flex items-center justify-center mx-auto mb-6 text-2xl">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h1 class="text-2xl font-bold mb-1">Sprint Bot Admin</h1>
            <p class="text-xs text-slate-400 mb-6">Enter your security key to access the command center</p>
            
            <input type="password" id="admin-pass" onkeyup="if(event.key === 'Enter') login()" placeholder="Enter Access Key" class="w-full bg-white/5 border border-white/10 px-5 py-3.5 rounded-xl font-mono text-center text-lg tracking-[0.4em] mb-4 focus:border-[#10b981] outline-none transition-all">
            <button id="login-btn" onclick="login()" class="w-full py-3.5 bg-[#10b981] hover:bg-[#059669] text-white font-bold rounded-xl transition-all shadow-lg shadow-[#10b981]/20">Login to Command Center</button>
        </div>
    </div>

    <!-- Main Dashboard Application -->
    <div id="app" class="hidden flex-1 flex flex-col md:flex-row overflow-hidden relative w-full">
        
        <!-- Sidebar Navigation -->
        <aside id="sidebar" class="w-64 bg-[#111827] border-r border-white/10 flex flex-col shrink-0 p-5 overflow-y-auto">
            <div class="flex items-center gap-3 mb-8 px-2">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#10b981] to-[#6366f1] p-0.5 shadow-md shrink-0">
                    <div class="w-full h-full rounded-xl bg-[#0b0f19] flex items-center justify-center text-[#10b981] font-bold text-lg">
                        <i class="fas fa-robot"></i>
                    </div>
                </div>
                <div>
                    <h2 class="font-bold text-base leading-tight">Sprint Bot</h2>
                    <span class="text-[10px] text-[#10b981] font-semibold tracking-wider uppercase bg-[#10b981]/10 px-2 py-0.5 rounded border border-[#10b981]/20">Command Center v5.3</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="space-y-1 mb-6">
                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-3 mb-2">Core Modules</div>
                <button onclick="switchTab('overview')" id="nav-overview" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-[#10b981] fa-desktop text-xs w-4"></i> Overview & Live HUD</button>
                <button onclick="switchTab('writers')" id="nav-writers" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-users-gear text-xs w-4"></i> Writers & PIN Access</button>
                <button onclick="switchTab('analytics')" id="nav-analytics" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-chart-line text-xs w-4"></i> Performance Analytics</button>
            </div>

            <div class="space-y-1 mb-6">
                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-3 mb-2">Management</div>
                <button onclick="switchTab('sprints')" id="nav-sprints" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-stopwatch text-xs w-4"></i> Sprints & Missions</button>
                <button onclick="switchTab('groups')" id="nav-groups" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-comments text-xs w-4"></i> WhatsApp Groups</button>
                <button onclick="switchTab('broadcast')" id="nav-broadcast" class="nav-link w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white transition"><i class="fas fa-paper-plane text-xs w-4"></i> Broadcast Channel</button>
                <button onclick="switchTab('feedback')" id="nav-feedback" class="nav-link w-full flex items-center justify-between px-4 py-2.5 text-sm text-slate-300 hover:text-white transition">
                    <span class="flex items-center gap-3"><i class="fas fa-inbox text-xs w-4"></i> Feedback Inbox</span>
                    <span id="unread-count" class="hidden text-[10px] font-bold bg-[#ef4444] text-white px-2 py-0.5 rounded-full">0</span>
                </button>
            </div>

            <div class="mt-auto pt-4 border-t border-white/10 space-y-2">
                <button onclick="logout()" class="w-full py-2 text-slate-400 hover:text-red-400 text-xs font-semibold text-left px-3 transition flex items-center gap-2">
                    <i class="fas fa-arrow-right-from-bracket"></i> Sign Out
                </button>
            </div>
        </aside>

        <!-- Main Content View Area -->
        <main class="flex-1 flex flex-col overflow-hidden relative bg-[#0b0f19]">
            
            <!-- Top App Bar -->
            <header class="h-16 border-b border-white/10 flex items-center justify-between px-6 shrink-0 bg-[#111827]">
                <div class="flex items-center gap-3">
                    <h2 id="view-title" class="font-bold text-lg text-white">Overview & Live HUD</h2>
                    <span id="conn-badge" class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Connected
                    </span>
                </div>
                
                <div class="flex items-center gap-3">
                    <button onclick="refreshData()" title="Refresh Dashboard" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 hover:bg-white/10 text-slate-300 flex items-center justify-center transition">
                        <i class="fas fa-sync-alt text-xs"></i>
                    </button>
                </div>
            </header>

            <!-- Tab Content Views -->
            <div class="flex-1 overflow-y-auto p-6 space-y-6">
                
                <!-- VIEW 1: OVERVIEW & LIVE HUD (MATCHES SPRINT BOT PUBLIC DASHBOARD LOOK) -->
                <div id="view-overview" class="space-y-6">
                    
                    <!-- Top KPI Cards (Screenshot 1 Match) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="panel p-5 flex items-center justify-between">
                            <div>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Total Words</div>
                                <div id="hud-total-words" class="text-3xl font-extrabold text-white font-mono">...</div>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center text-lg">
                                ✍️
                            </div>
                        </div>

                        <div class="panel p-5 flex items-center justify-between">
                            <div>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Total Writers</div>
                                <div id="hud-total-writers" class="text-3xl font-extrabold text-white font-mono">...</div>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 flex items-center justify-center text-lg">
                                👥
                            </div>
                        </div>

                        <div class="panel p-5 flex items-center justify-between">
                            <div>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Active Groups</div>
                                <div id="hud-active-groups" class="text-3xl font-extrabold text-white font-mono">...</div>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center text-lg">
                                🥞
                            </div>
                        </div>

                        <div class="panel p-5 flex items-center justify-between">
                            <div>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">System Status</div>
                                <div id="hud-sys-status" class="text-2xl font-bold text-emerald-400">Active</div>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center text-lg">
                                🤖
                            </div>
                        </div>
                    </div>

                    <!-- Sprint Velocity Curve Chart (Screenshot 1 Match) -->
                    <div class="panel p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-base font-bold text-white">Sprint Velocity</h3>
                            <span class="text-xs text-emerald-400 font-bold flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Live Data
                            </span>
                        </div>
                        <div class="h-64"><canvas id="hud-chart-velocity"></canvas></div>
                    </div>

                    <!-- 3-Column Live Leaderboards Grid (Screenshot 2 Match) -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        
                        <!-- Hall of Fame -->
                        <div class="panel p-5 space-y-4">
                            <h3 class="text-sm font-bold text-white flex items-center gap-2">
                                🏆 Hall of Fame
                            </h3>
                            <div id="hud-hall-of-fame" class="space-y-2 text-xs divide-y divide-white/5">
                                <!-- Populated dynamically -->
                            </div>
                        </div>

                        <!-- Today's Top -->
                        <div class="panel p-5 space-y-4">
                            <div class="flex items-center justify-between">
                                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                                    ⏱️ Today's Top
                                </h3>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">LIVE</span>
                            </div>
                            <div id="hud-todays-top" class="space-y-2 text-xs divide-y divide-white/5">
                                <!-- Populated dynamically -->
                            </div>
                        </div>

                        <!-- Top Groups -->
                        <div class="panel p-5 space-y-4">
                            <h3 class="text-sm font-bold text-white flex items-center gap-2">
                                👑 Top Groups
                            </h3>
                            <div id="hud-top-groups" class="space-y-2 text-xs divide-y divide-white/5">
                                <!-- Populated dynamically -->
                            </div>
                        </div>

                    </div>

                    <!-- QR Code & Connection Status Box -->
                    <div id="qr-container" class="panel p-6 bg-gradient-to-r from-[#111827] to-[#1f2937] border-emerald-500/30">
                        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                            <div class="space-y-2 flex-1">
                                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">
                                    <i class="fas fa-qrcode"></i> WhatsApp Pairing Scanner
                                </div>
                                <h3 class="text-xl font-bold text-white">Pair WhatsApp Account</h3>
                                <p class="text-xs text-slate-300">
                                    If the bot disconnects or needs pairing, open WhatsApp on your phone → <b>Settings</b> → <b>Linked Devices</b> → <b>Link a Device</b> and point your camera at this QR code.
                                </p>
                            </div>

                            <div id="qr-box" class="w-44 h-44 bg-white p-2 rounded-2xl flex items-center justify-center shadow-2xl shrink-0">
                                <div class="text-slate-500 text-xs text-center font-bold">Scanning Socket...</div>
                            </div>
                        </div>
                    </div>

                    <!-- Global Maintenance Panel -->
                    <div class="panel p-5 flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/30 flex items-center justify-center text-lg">
                                <i class="fas fa-wrench"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-sm">Maintenance Mode</h3>
                                <p class="text-xs text-slate-400">Locks bot commands for all non-admin users</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span id="maint-status" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-slate-400 border border-slate-700">Inactive</span>
                            <button onclick="toggleMaintenance()" id="maint-btn" class="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-bold transition">Activate</button>
                        </div>
                    </div>

                    <!-- Activity Stream -->
                    <div class="panel p-5">
                        <h3 class="text-sm font-bold mb-4 text-slate-200">System Activity Stream</h3>
                        <div id="sys-log" class="space-y-2 max-h-[250px] overflow-y-auto font-mono text-xs text-slate-300"></div>
                    </div>

                </div>

                <!-- VIEW 2: WRITERS & PIN ACCESS (ZOHO BOOKS 2-COLUMN SPLIT VIEW) -->
                <div id="view-writers" class="hidden space-y-6">
                    
                    <!-- Header Bar -->
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                        <div class="flex items-center gap-2 w-full sm:w-auto">
                            <input type="text" id="writer-search" oninput="loadWritersGrid()" placeholder="Search writers by name or phone..." class="bg-white/5 border border-white/10 px-4 py-2 rounded-xl text-xs w-full sm:w-64 outline-none focus:border-emerald-400">
                            
                            <select id="writer-filter" onchange="loadWritersGrid()" class="bg-[#1f2937] border border-white/10 px-3 py-2 rounded-xl text-xs outline-none">
                                <option value="all">All Writers</option>
                                <option value="active">Active Only</option>
                                <option value="inactive">Inactive</option>
                                <option value="archived">Archived</option>
                                <option value="banned">Banned</option>
                            </select>
                        </div>

                        <div class="text-xs text-slate-400 font-medium">
                            Total: <span id="writers-count" class="font-bold text-white">0</span> writers
                        </div>
                    </div>

                    <!-- ZOHO BOOKS 2-COLUMN SPLIT CONTAINER -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                        
                        <!-- Left Pane: Writers List (~4 columns) -->
                        <div class="lg:col-span-4 panel p-4 space-y-2 max-h-[700px] overflow-y-auto">
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider px-2 mb-3">Writer Accounts</div>
                            <div id="writers-split-list" class="space-y-2">
                                <!-- Populated dynamically -->
                            </div>
                        </div>

                        <!-- Right Pane: Selected Writer Detail & Actions (~8 columns) -->
                        <div class="lg:col-span-8 panel p-6 space-y-6">
                            <div id="split-detail-empty" class="text-center py-20 text-slate-500 text-xs">
                                Select a writer from the left list to view details and manage access.
                            </div>

                            <div id="split-detail-content" class="hidden space-y-6">
                                
                                <!-- Selected Writer Header -->
                                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-white/10">
                                    <div class="flex items-center gap-4">
                                        <div id="sp-avatar" class="w-14 h-14 rounded-2xl bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center text-xl border border-emerald-500/30"></div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h3 id="sp-name" class="font-bold text-xl text-white"></h3>
                                                <span id="sp-status-badge"></span>
                                            </div>
                                            <div id="sp-phone" class="text-xs font-mono text-slate-400 mt-0.5"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Toolbar -->
                                <div class="flex flex-wrap gap-2">
                                    <button onclick="copyWriterProfileLink()" class="py-2 px-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-bold text-slate-200 transition flex items-center gap-1.5">
                                        <i class="fas fa-link text-emerald-400"></i> Copy Profile Link
                                    </button>
                                    <button onclick="copyWriterPin()" class="py-2 px-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-bold text-slate-200 transition flex items-center gap-1.5">
                                        <i class="fas fa-key text-amber-400"></i> Copy Web PIN
                                    </button>
                                    <button onclick="resetDrawerPin()" class="py-2 px-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-bold text-slate-200 transition flex items-center gap-1.5">
                                        <i class="fas fa-dice text-indigo-400"></i> Reset PIN
                                    </button>
                                    <button onclick="toggleWriterArchive()" id="sp-archive-btn" class="py-2 px-3 bg-purple-500/20 hover:bg-purple-500/30 text-purple-300 border border-purple-500/30 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                                        <i class="fas fa-box-archive"></i> Archive User
                                    </button>
                                    <button onclick="toggleWriterInactive()" id="sp-inactive-btn" class="py-2 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                                        <i class="fas fa-moon"></i> Toggle Inactive
                                    </button>
                                    <button onclick="grantFreezeModal(activeDrawerUserId)" class="py-2 px-3 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                                        🛡️ Grant Freeze
                                    </button>
                                    <button onclick="toggleDrawerBan()" id="sp-ban-btn" class="py-2 px-3 bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/30 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                                        <i class="fas fa-ban"></i> Ban User
                                    </button>
                                </div>

                                <!-- Editable Stats Grid -->
                                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                                    <div class="panel p-4 bg-white/5">
                                        <div class="text-[10px] text-slate-400 font-bold uppercase">Total Words</div>
                                        <div class="flex items-center justify-between mt-1">
                                            <div id="sp-total-words" class="text-xl font-bold font-mono text-white"></div>
                                            <button onclick="editWriterWords()" class="text-xs text-slate-400 hover:text-emerald-400 p-1" title="Edit Total Words"><i class="fas fa-pen"></i></button>
                                        </div>
                                    </div>

                                    <div class="panel p-4 bg-white/5">
                                        <div class="text-[10px] text-slate-400 font-bold uppercase">Current Streak</div>
                                        <div class="flex items-center justify-between mt-1">
