        // --- Writers & Bulk ---
        async function loadWritersGrid() {
            const container = document.getElementById('writers-grid');
            container.innerHTML = '<div class="col-span-full text-center py-10 opacity-40"><i class="fas fa-spinner fa-spin text-3xl"></i></div>';
            try {
                const data = await api('/api/admin/search', { query: '' });
                currentWriters = Array.isArray(data) ? data : [];
                applyWriterSort(); updateBulkActionBar();
            } catch(e) { container.innerHTML = '<div class="col-span-full text-center py-10 font-bold text-red-500">Error loading writers.</div>'; }
        }
        function applyWriterSort() {
            const criteria = document.getElementById('sort-writers').value;
            let sorted = [...currentWriters];
            if (criteria === 'words') sorted.sort((a, b) => b.totalWords - a.totalWords);
            else if (criteria === 'name') sorted.sort((a, b) => a.name.localeCompare(b.name));
            else sorted.sort((a, b) => new Date(b.lastActive || 0) - new Date(a.lastActive || 0));
            renderWriters(sorted);
        }
        let allUsersCache = {}; let selectedUserForDrawer = null;
        function renderWriters(users) {
            const container = document.getElementById('writers-grid');
            container.innerHTML = ''; allUsersCache = {};
            if (!users || users.length === 0) { container.innerHTML = '<div class="col-span-full text-center p-10 font-bold opacity-50">No writers found.</div>'; return; }

            users.forEach(u => {
                allUsersCache[u._id] = u;
                const total = u.trueTotal || u.totalWords || 0;
                const isBanned = u.isBanned; const isSelected = selectedWriters.includes(u._id);
                const focusClass = isSelected ? 'ring-4 ring-emerald-500/50' : '';
                const bannedClass = isBanned ? 'opacity-50 grayscale' : '';
                const badgeHtml = isBanned ? '<span class="text-[9px] bg-red-500 text-white px-2 py-1 rounded-lg ml-2 shadow-inner">BANNED</span>' : '';

                container.innerHTML += `
                    <div class="panel p-6 flex items-center gap-5 cursor-pointer relative ${focusClass} ${bannedClass}" onclick="openWriterDrawer('${u._id}')">
                        
                        <div class="absolute top-4 right-4 z-10" onclick="event.stopPropagation(); toggleWriterSelection('${u._id}')">
                            <div class="w-6 h-6 rounded-lg ${isSelected ? 'panel-inset text-emerald-500' : 'panel opacity-50'} flex items-center justify-center transition">
                                ${isSelected ? '<i class="fas fa-check text-xs"></i>' : ''}
                            </div>
                        </div>

                        <div class="w-14 h-14 rounded-2xl panel-inset flex items-center justify-center text-xl font-black text-bold shrink-0">${u.name.charAt(0).toUpperCase()}</div>
                        <div class="flex-1 min-w-0 pr-6">
                            <h3 class="font-extrabold text-bold text-lg truncate flex items-center">${u.name} ${badgeHtml}</h3>
                            <p class="text-[10px] uppercase font-bold tracking-widest opacity-60 mt-1">${u.rank || 'Unranked'}</p>
                        </div>
                        <div class="text-right shrink-0 pb-1">
                            <div class="text-[#10b981] font-black text-2xl leading-none">${total.toLocaleString()}</div>
                            <div class="text-[9px] uppercase font-bold tracking-widest opacity-40 mt-2">Words</div>
                        </div>
                    </div>`;
            });
            filterWriterCards();
        }
        function filterWriterCards() {
            const query = document.getElementById('dash-search').value.toLowerCase();
            document.querySelectorAll('#writers-grid > div').forEach(item => { item.classList.toggle('hidden', !item.innerText.toLowerCase().includes(query)); });
        }
        function toggleWriterSelection(id) { 
            if (selectedWriters.includes(id)) selectedWriters = selectedWriters.filter(i => i !== id);
            else selectedWriters.push(id); 
            applyWriterSort(); updateBulkActionBar(); 
        }
        function clearBulkSelection() { selectedWriters = []; applyWriterSort(); updateBulkActionBar(); }
        function updateBulkActionBar() {
            const bar = document.getElementById('bulk-action-bar');
            if (selectedWriters.length > 0) { 
                document.getElementById('bulk-count').innerText = `${selectedWriters.length} Selected`; 
                bar.classList.remove('hidden'); 
            } else { 
                bar.classList.add('hidden');
            }
        }
        function exportWritersCSV() {
            const selected = currentWriters.filter(w => selectedWriters.includes(w._id));
            if(!selected.length) return;
            let csv = "ID,Name,Total Words,Rank,Current Streak,Best Sprint Words\n";
            selected.forEach(w => csv += `"${w._id}","${w.name}",${w.trueTotal},"${w.rank}",${w.streak},${w.bestSprintWords || 0}\n`);
            const blob = new Blob([csv], {type: 'text/csv'}); const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url;
            a.download = 'sprintbot_writers.csv'; a.click();
            showToast(`Exported ${selected.length} writers.`);
        }
