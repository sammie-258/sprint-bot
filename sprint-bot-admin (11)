    <!-- Script Application Logic -->
    <script>
        let adminPass = localStorage.getItem('admin_pass') || '';
        let currentTab = 'overview';
        let writersCache = [];
        let selectedWriters = [];
        let activeDrawerUserId = null;
        let revealedPins = new Set();
        let bcImageBase64 = null;
        let velocityChart = null, hoursChart = null;

        // Custom Confirm Callback
        let confirmResolve = null;
        function showConfirm(msg, title = "Confirm Action") {
            return new Promise((resolve) => {
                confirmResolve = resolve;
                document.getElementById('confirm-title').innerText = title;
                document.getElementById('confirm-msg').innerText = msg;
                document.getElementById('confirm-modal').classList.remove('hidden');
            });
        }
        function closeConfirmModal(result) {
            document.getElementById('confirm-modal').classList.add('hidden');
            if (confirmResolve) confirmResolve(result);
        }

        // Custom Prompt Callback
        let promptResolve = null;
        function showPrompt(title, defaultValue = "") {
            return new Promise((resolve) => {
                promptResolve = resolve;
                document.getElementById('prompt-title').innerText = title;
                document.getElementById('prompt-input').value = defaultValue;
                document.getElementById('prompt-modal').classList.remove('hidden');
            });
        }
        function closePromptModal(val) {
            document.getElementById('prompt-modal').classList.add('hidden');
            if (promptResolve) promptResolve(val);
        }

        // Custom Toast Notification
        function showToast(msg, type = "success") {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `p-4 rounded-xl text-xs font-bold shadow-2xl flex items-center gap-2 pointer-events-auto transition-all ${type === 'error' ? 'bg-red-900/90 text-red-200 border border-red-500/50' : 'bg-emerald-950/90 text-emerald-200 border border-emerald-500/50'}`;
            toast.innerHTML = `<i class="fas ${type === 'error' ? 'fa-circle-xmark' : 'fa-circle-check'}"></i> <span>${msg}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3500);
        }

        async function api(endpoint, body = null) {
            const options = {
                method: body ? 'POST' : 'GET',
                headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPass }
            };
            if (body) options.body = JSON.stringify(body);
            try {
                const res = await fetch(endpoint, options);
                if (res.status === 403) { logout(); return null; }
                return await res.json();
            } catch (e) {
                console.error("API error:", e);
                return null;
            }
        }

        async function login() {
            adminPass = document.getElementById('admin-pass').value.trim();
            if (!adminPass) return showToast("Please enter access key", "error");
            const res = await api('/api/admin/system');
            if (res && !res.error) {
                localStorage.setItem('admin_pass', adminPass);
                document.getElementById('auth-modal').classList.add('hidden');
                document.getElementById('app').classList.remove('hidden');
                switchTab('overview');
            } else {
                showToast("Invalid Access Key", "error");
            }
        }

        function logout() {
            localStorage.removeItem('admin_pass');
            adminPass = '';
            document.getElementById('app').classList.add('hidden');
            document.getElementById('auth-modal').classList.remove('hidden');
        }

        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('active'));
            const navEl = document.getElementById('nav-' + tab);
            if (navEl) navEl.classList.add('active');

            document.querySelectorAll('[id^="view-"]').forEach(el => el.classList.add('hidden'));
            const viewEl = document.getElementById('view-' + tab);
            if (viewEl) viewEl.classList.remove('hidden');

            document.getElementById('view-title').innerText = tab.charAt(0).toUpperCase() + tab.slice(1);
            refreshData();
        }

        async function refreshData() {
            if (currentTab === 'overview') loadOverview();
            else if (currentTab === 'writers') loadWritersGrid();
            else if (currentTab === 'analytics') loadAnalytics();
            else if (currentTab === 'sprints') { loadSprints(); loadScheduledSprints(); populateGroupDropdowns(); }
            else if (currentTab === 'groups') loadGroups();
            else if (currentTab === 'broadcast') populateGroupDropdowns();
            else if (currentTab === 'feedback') loadFeedback();
        }

        async function loadOverview() {
            const sys = await api('/api/admin/system');
            if (sys) {
                document.getElementById('sys-mem').innerText = sys.memory + " MB";
                document.getElementById('sys-uptime').innerText = Math.floor(sys.uptime / 3600) + "h " + Math.floor((sys.uptime % 3600)/60) + "m";
                document.getElementById('sys-sprints-count').innerText = sys.activeSprintsCount || 0;
                
                const connBadge = document.getElementById('conn-badge');
                const connDisplay = document.getElementById('conn-display');
                const qrBox = document.getElementById('qr-box');

                if (sys.isConnected) {
                    connBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Connected`;
                    connBadge.className = "text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5";
                    connDisplay.innerHTML = `<i class="fas fa-circle-check text-emerald-400 text-2xl"></i><span class="font-bold text-sm text-slate-200">Online & Ready</span>`;
                    qrBox.innerHTML = `<div class="text-emerald-500 font-bold text-xs text-center"><i class="fas fa-circle-check text-2xl mb-1 block"></i>WhatsApp Paired</div>`;
                } else {
                    connBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> Pairing Required`;
                    connBadge.className = "text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center gap-1.5";
                    connDisplay.innerHTML = `<i class="fas fa-triangle-exclamation text-amber-400 text-2xl"></i><span class="font-bold text-sm text-slate-200">Pairing Needed</span>`;
                    
                    if (sys.qrCode) {
                        qrBox.innerHTML = `<img src="${sys.qrCode}" class="w-full h-full object-contain rounded-lg">`;
                    } else {
                        qrBox.innerHTML = `<div class="text-slate-500 text-xs text-center font-bold">Generating QR Code...</div>`;
                    }
                }

                const maintBtn = document.getElementById('maint-btn');
                const maintStatus = document.getElementById('maint-status');
                if (sys.maintenance) {
                    maintStatus.innerText = "ACTIVE";
                    maintStatus.className = "text-xs font-bold px-3 py-1 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30";
                    maintBtn.innerText = "Deactivate";
                } else {
                    maintStatus.innerText = "Inactive";
                    maintStatus.className = "text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-slate-400 border border-slate-700";
                    maintBtn.innerText = "Activate";
                }

                // System Activity Stream formatting fix
                if (sys.recentActivity) {
                    document.getElementById('sys-log').innerHTML = sys.recentActivity.map(a => {
                        const dateObj = new Date(a.at || a.time || Date.now());
                        const timeStr = isNaN(dateObj.getTime()) ? new Date().toLocaleTimeString() : dateObj.toLocaleTimeString();
                        return `<div><span class="text-slate-500">[${timeStr}]</span> ${a.text}</div>`;
                    }).join('');
                }
            }
        }

        async function toggleMaintenance() {
            const status = document.getElementById('maint-status').innerText !== "ACTIVE";
            await api('/api/admin/maintenance', { status });
            loadOverview();
        }

        async function loadWritersGrid() {
            const query = document.getElementById('writer-search').value;
            const filter = document.getElementById('writer-filter').value;
            const data = await api('/api/admin/search', { query });
            writersCache = data || [];
            document.getElementById('writers-count').innerText = writersCache.length;

            let list = [...writersCache];
            if (filter === 'active') list = list.filter(u => !u.isArchived && !u.isInactive && !u.isBanned);
            else if (filter === 'inactive') list = list.filter(u => u.isInactive);
            else if (filter === 'archived') list = list.filter(u => u.isArchived);
            else if (filter === 'banned') list = list.filter(u => u.isBanned);

            const tbody = document.getElementById('writers-table-body');
            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-slate-500">No writers found matching search criteria.</td></tr>`;
                return;
            }

            tbody.innerHTML = list.map(u => {
                const isSelected = selectedWriters.includes(u._id);
                const isRevealed = revealedPins.has(u._id);
                const pinDisplay = isRevealed ? (u.webPin || '----') : '••••';
                let statusBadge = `<span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">Active</span>`;
                if (u.isBanned) statusBadge = `<span class="px-2 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20 text-[10px]">Banned</span>`;
                else if (u.isArchived) statusBadge = `<span class="px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20 text-[10px]">Archived</span>`;
                else if (u.isInactive) statusBadge = `<span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 text-[10px]">Inactive</span>`;

                return `
                    <tr class="hover:bg-white/5 transition cursor-pointer" onclick="openWriterDrawer('${u._id}')">
                        <td class="py-3 px-4" onclick="event.stopPropagation()">
                            <input type="checkbox" ${isSelected ? 'checked' : ''} onchange="toggleWriterSelection('${u._id}')" class="w-4 h-4 accent-emerald-500 cursor-pointer">
                        </td>
                        <td class="py-3 px-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center text-xs">
                                    ${u.name.charAt(0).toUpperCase()}
                                </div>
                                <div class="font-bold text-white">${u.name}</div>
                            </div>
                        </td>
                        <td class="py-3 px-4 font-mono text-slate-400">${u._id.split('@')[0]}</td>
                        <td class="py-3 px-4">
                            <div class="font-bold text-white font-mono">${(u.totalWords || 0).toLocaleString()}</div>
                            <div class="text-[10px] text-emerald-400">${u.rank || 'Novice'}</div>
                        </td>
                        <td class="py-3 px-4 font-mono font-bold text-amber-400">${u.streak || 0}🔥</td>
                        <td class="py-3 px-4 font-mono" onclick="event.stopPropagation()">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-emerald-400 tracking-wider">${pinDisplay}</span>
                                <button onclick="togglePinReveal('${u._id}')" class="text-slate-400 hover:text-white p-1" title="Show/Hide PIN">
                                    <i class="fas ${isRevealed ? 'fa-eye-slash' : 'fa-eye'}"></i>
                                </button>
                                <button onclick="resetUserPin('${u._id}')" class="text-slate-400 hover:text-emerald-400 p-1" title="Generate New PIN">
                                    <i class="fas fa-dice"></i>
                                </button>
                            </div>
                        </td>
                        <td class="py-3 px-4">${statusBadge}</td>
                        <td class="py-3 px-4 text-right space-x-1" onclick="event.stopPropagation()">
                            <button onclick="grantFreezeModal('${u._id}')" class="px-2 py-1 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 rounded-lg text-xs transition" title="Grant Freeze">
                                🛡️
                            </button>
                            <button onclick="toggleWriterBan('${u._id}', ${!u.isBanned})" class="px-2.5 py-1 ${u.isBanned ? 'bg-emerald-500/20 text-emerald-400' : 'bg-red-500/20 text-red-400'} rounded-lg transition" title="${u.isBanned ? 'Unban Writer' : 'Ban Writer'}">
                                <i class="fas ${u.isBanned ? 'fa-user-check' : 'fa-user-slash'}"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            updateBulkBar();
        }

        // ZOHO BOOKS STYLE WRITER DETAIL DRAWER
        async function openWriterDrawer(userId) {
            activeDrawerUserId = userId;
            const u = writersCache.find(x => x._id === userId);
            if (!u) return;

            document.getElementById('dr-avatar').innerText = u.name.charAt(0).toUpperCase();
            document.getElementById('dr-name').innerText = u.name;
            document.getElementById('dr-phone').innerText = u._id.split('@')[0];
            document.getElementById('dr-total-words').innerText = (u.totalWords || 0).toLocaleString();
            document.getElementById('dr-streak').innerText = (u.streak || 0) + "🔥";
            document.getElementById('dr-rank').innerText = `${u.rank || 'Novice'} • Best WPM: ${u.bestSprintWpm || 0}`;
            document.getElementById('dr-pin-display').innerText = u.webPin || '----';

            const banBtn = document.getElementById('dr-ban-btn');
            if (u.isBanned) {
                banBtn.className = "py-2 px-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5";
                banBtn.innerHTML = `<i class="fas fa-check"></i> Unban User`;
            } else {
                banBtn.className = "py-2 px-3 bg-red-500/20 text-red-300 border border-red-500/30 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5";
                banBtn.innerHTML = `<i class="fas fa-ban"></i> Ban User`;
            }

            document.getElementById('writer-drawer-overlay').classList.remove('hidden');
            document.getElementById('writer-drawer').classList.add('open');

            // Load drawer sprint history
            const hist = await api('/api/admin/writer/' + encodeURIComponent(userId) + '/history');
            const histBox = document.getElementById('dr-sprint-history');
            if (hist && hist.recentSprints && hist.recentSprints.length > 0) {
                histBox.innerHTML = hist.recentSprints.map(s => `
                    <div class="p-3 bg-white/5 rounded-xl flex items-center justify-between">
                        <div>
                            <div class="text-white font-bold">${s.words.toLocaleString()} words</div>
                            <div class="text-[10px] text-slate-400">${new Date(s.date).toLocaleDateString()} • ${s.duration} min sprint</div>
                        </div>
                        <div class="text-emerald-400 font-bold">${s.wpm} WPM</div>
                    </div>
                `).join('');
            } else {
                histBox.innerHTML = `<div class="text-slate-500 text-xs text-center py-4">No recent sprint history.</div>`;
            }
        }

        function closeWriterDrawer() {
            document.getElementById('writer-drawer').classList.remove('open');
            document.getElementById('writer-drawer-overlay').classList.add('hidden');
        }

        function copyWriterProfileLink() {
            if (!activeDrawerUserId) return;
            const phone = activeDrawerUserId.split('@')[0];
            const url = window.location.origin + '/profile/' + phone;
            navigator.clipboard.writeText(url);
            showToast("Copied Profile Link: " + url);
        }

        function copyWriterPin() {
            const u = writersCache.find(x => x._id === activeDrawerUserId);
            if (u && u.webPin) {
                navigator.clipboard.writeText(u.webPin);
                showToast("Copied PIN: " + u.webPin);
            }
        }

        async function resetDrawerPin() {
            if (!activeDrawerUserId) return;
            const res = await api('/api/admin/user/set-pin', { userId: activeDrawerUserId });
            if (res?.success) {
                showToast("New PIN Generated: " + res.webPin);
                document.getElementById('dr-pin-display').innerText = res.webPin;
                loadWritersGrid();
            }
        }

        async function toggleDrawerBan() {
            if (!activeDrawerUserId) return;
            const u = writersCache.find(x => x._id === activeDrawerUserId);
            const isBanning = !u?.isBanned;
            const confirmed = await showConfirm(`Are you sure you want to ${isBanning ? 'BAN' : 'UNBAN'} this writer?`);
            if (confirmed) {
                await api('/api/admin/ban', { userId: activeDrawerUserId, action: isBanning ? 'ban' : 'unban' });
                showToast(isBanning ? "Writer Banned" : "Writer Unbanned");
                closeWriterDrawer();
                loadWritersGrid();
            }
        }

        async function editWriterWords() {
            if (!activeDrawerUserId) return;
            const u = writersCache.find(x => x._id === activeDrawerUserId);
            const val = await showPrompt("Set New Total Word Count:", u?.totalWords || 0);
            if (val !== null) {
                await api('/api/admin/update', { userId: activeDrawerUserId, type: 'set', amount: parseInt(val, 10) });
                showToast("Total words updated!");
                closeWriterDrawer();
                loadWritersGrid();
            }
        }

        async function editWriterStreak() {
            if (!activeDrawerUserId) return;
            const u = writersCache.find(x => x._id === activeDrawerUserId);
            const val = await showPrompt("Set Current Streak (Days):", u?.streak || 0);
            if (val !== null) {
                const streakNum = parseInt(val, 10);
                await api('/api/admin/update', { userId: activeDrawerUserId, type: 'streak', currentStreak: streakNum, bestStreak: Math.max(streakNum, u?.bestStreak || 0) });
                showToast("Streak updated!");
                closeWriterDrawer();
                loadWritersGrid();
            }
        }

        function toggleWriterSelection(id) {
            if (selectedWriters.includes(id)) selectedWriters = selectedWriters.filter(i => i !== id);
            else selectedWriters.push(id);
            updateBulkBar();
        }

        function selectAllWriters() {
            if (selectedWriters.length === writersCache.length) selectedWriters = [];
            else selectedWriters = writersCache.map(u => u._id);
            loadWritersGrid();
        }

        function clearSelection() { selectedWriters = []; loadWritersGrid(); }

        function updateBulkBar() {
            const bar = document.getElementById('bulk-bar');
            if (selectedWriters.length > 0) {
                document.getElementById('bulk-count').textContent = selectedWriters.length;
                bar.classList.remove('hidden');
            } else { bar.classList.add('hidden'); }
        }

        async function bulkBan() {
            if (!selectedWriters.length) return;
            const ok = await showConfirm(`Ban ${selectedWriters.length} selected writers?`);
            if (ok) {
                for (const id of selectedWriters) await api('/api/admin/ban', { userId: id, action: 'ban' });
                showToast(`${selectedWriters.length} writers banned`);
                clearSelection();
            }
        }

        async function bulkFreeze() {
            if (!selectedWriters.length) return;
            const num = await showPrompt("Enter number of streak freezes to grant:", "1");
            if (num) {
                for (const id of selectedWriters) await api('/api/admin/writers/freeze', { userId: id, amount: parseInt(num, 10) });
                showToast(`Granted ${num} freeze(s) to selected writers!`);
                clearSelection();
            }
        }

        async function grantFreezeModal(userId) {
            const num = await showPrompt("Enter streak freezes to grant:", "1");
            if (num) {
                const res = await api('/api/admin/writers/freeze', { userId, amount: parseInt(num, 10) });
                if (res?.success) showToast(`Granted ${num} freeze(s)! New total: ${res.newTotal}`);
            }
        }

        function togglePinReveal(userId) {
            if (revealedPins.has(userId)) revealedPins.delete(userId);
            else revealedPins.add(userId);
            loadWritersGrid();
        }

        async function resetUserPin(userId) {
            const res = await api('/api/admin/user/set-pin', { userId });
            if (res?.success) {
                revealedPins.add(userId);
                showToast(`New PIN generated for ${userId.split('@')[0]}: ${res.webPin}`);
                loadWritersGrid();
            }
        }

        function quickPinLookup(val) {
            const q = val.trim().toLowerCase();
            const resBox = document.getElementById('quick-pin-result');
            if (!q) { resBox.classList.add('hidden'); return; }
            
            const match = writersCache.find(u => u.name.toLowerCase().includes(q) || u._id.includes(q));
            if (match) {
                document.getElementById('qp-avatar').innerText = match.name.charAt(0).toUpperCase();
                document.getElementById('qp-name').innerText = match.name;
                document.getElementById('qp-phone').innerText = match._id.split('@')[0];
                document.getElementById('qp-pin').innerText = match.webPin || '----';
                resBox.classList.remove('hidden');
            } else {
                resBox.classList.add('hidden');
            }
        }

        function copyQuickPin() {
            const pin = document.getElementById('qp-pin').innerText;
            navigator.clipboard.writeText(pin);
            showToast("PIN copied: " + pin);
        }

        function openWriterEditModal(userId) {
            editingUserId = userId;
            const u = writersCache.find(x => x._id === userId);
            if (!u) return;
            document.getElementById('edit-w-name').value = u.name;
            document.getElementById('edit-w-streak').value = u.streak || 0;
            document.getElementById('edit-w-pin').value = u.webPin || '';
            document.getElementById('writer-edit-modal').classList.remove('hidden');
        }

        function closeWriterEditModal() {
            document.getElementById('writer-edit-modal').classList.add('hidden');
        }

        function generateEditPin() {
            document.getElementById('edit-w-pin').value = Math.floor(1000 + Math.random() * 9000).toString();
        }

        async function saveWriterEdit() {
            if (!editingUserId) return;
            const name = document.getElementById('edit-w-name').value.trim();
            const streak = parseInt(document.getElementById('edit-w-streak').value, 10);
            const pin = document.getElementById('edit-w-pin').value.trim();

            if (name) await api('/api/admin/update', { userId: editingUserId, type: 'name', name });
            if (!isNaN(streak)) await api('/api/admin/update', { userId: editingUserId, type: 'streak', currentStreak: streak, bestStreak: streak });
            if (pin && pin.length === 4) await api('/api/admin/user/set-pin', { userId: editingUserId, pin });

            closeWriterEditModal();
            showToast("Writer details saved!");
            loadWritersGrid();
        }

        async function toggleWriterBan(userId, isBanning) {
            const confirmed = await showConfirm(`Are you sure you want to ${isBanning ? 'BAN' : 'UNBAN'} this writer?`);
            if (confirmed) {
                await api('/api/admin/ban', { userId, action: isBanning ? 'ban' : 'unban' });
                showToast(isBanning ? "Writer Banned" : "Writer Unbanned");
                loadWritersGrid();
            }
        }

        async function loadAnalytics(range = 'weekly') {
            const data = await api('/api/admin/analytics?range=' + range);
            if (data) {
                document.getElementById('ana-retention').innerText = (data.retentionRate || 0) + "%";
                document.getElementById('ana-active-current').innerText = data.activeCurrentCount ?? 0;
                document.getElementById('ana-total-words').innerText = (data.totalLoggedWords || 0).toLocaleString();

                if (data.wordsByDay) {
                    const ctx1 = document.getElementById('chart-velocity').getContext('2d');
                    if (velocityChart) velocityChart.destroy();
                    velocityChart = new Chart(ctx1, {
                        type: 'bar',
                        data: {
                            labels: data.wordsByDay.labels,
                            datasets: [{ label: 'Words Logged', data: data.wordsByDay.data, backgroundColor: '#10b981' }]
                        },
                        options: { responsive: true, maintainAspectRatio: false }
                    });
                }

                if (data.wordsByHour) {
                    const ctx2 = document.getElementById('chart-hours').getContext('2d');
                    if (hoursChart) hoursChart.destroy();
                    hoursChart = new Chart(ctx2, {
                        type: 'line',
                        data: {
                            labels: data.wordsByHour.map(h => h.hour + ':00'),
                            datasets: [{ label: 'Hourly Words', data: data.wordsByHour.map(h => h.total), borderColor: '#6366f1', tension: 0.3 }]
                        },
                        options: { responsive: true, maintainAspectRatio: false }
                    });
                }
            }
        }

        async function loadSprints() {
            const sprints = await api('/api/admin/sprints');
            const list = document.getElementById('active-sprints-list');
            const hudList = document.getElementById('live-hud-container');

            if (!sprints || sprints.length === 0) {
                list.innerHTML = `<div class="text-center py-6 text-slate-500 text-xs">No active sprints running.</div>`;
                if (hudList) hudList.innerHTML = `<div class="text-slate-500 text-xs py-4 text-center">No active sprints running currently.</div>`;
                return;
            }

            const html = sprints.map(s => `
                <div class="flex items-center justify-between p-4 bg-white/5 rounded-xl border border-white/10">
                    <div>
                        <div class="font-bold text-sm text-white">${s.name}</div>
                        <div class="text-xs text-slate-400">${s.participants} participants • <span class="text-emerald-400 font-bold">${s.timeLeft}m remaining</span></div>
                    </div>
                    <button onclick="stopSprint('${s.id}')" class="px-3 py-1.5 bg-red-500/20 text-red-400 rounded-lg text-xs font-bold hover:bg-red-500/30 transition">Stop Sprint</button>
                </div>
            `).join('');

            list.innerHTML = html;
            if (hudList) hudList.innerHTML = html;
        }

        async function stopSprint(chatId) {
            const confirmed = await showConfirm("Stop this active sprint?");
            if (confirmed) {
                await api('/api/admin/sprints/stop', { chatId });
                showToast("Sprint stopped!");
                loadSprints();
            }
        }

        async function loadGroups() {
            const groups = await api('/api/admin/groups');
            const list = document.getElementById('groups-list');
            if (!groups || groups.length === 0) {
                list.innerHTML = `<div class="text-center py-6 text-slate-500 text-xs col-span-2">No groups found.</div>`;
                return;
            }
            list.innerHTML = groups.map(g => `
                <div class="panel p-5 space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="font-bold text-sm text-white truncate">${g.name}</div>
                        <span class="text-[10px] px-2 py-0.5 rounded ${g.health === 'Active' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-800 text-slate-400'} font-bold">${g.health}</span>
                    </div>
                    <div class="text-xs text-slate-400">
                        ${g.participants} members • 7-day words: <b class="text-white font-mono">${(g.weekWords||0).toLocaleString()}</b>
                    </div>
                    <div class="flex justify-end gap-2 pt-2">
                        <button onclick="leaveGroup('${g.id}')" class="px-3 py-1 bg-red-500/20 text-red-400 rounded-lg text-xs font-bold hover:bg-red-500/30 transition">Leave Group</button>
                    </div>
                </div>
            `).join('');
        }

        async function syncGroupsFromWA() {
            await api('/api/admin/groups/sync');
            showToast("Groups synced!");
            loadGroups();
        }

        async function acceptInvite() {
            const code = document.getElementById('invite-code-input').value.trim();
            if (!code) return showToast("Enter invite link or code", "error");
            const res = await api('/api/admin/groups/accept', { inviteCode: code });
            if (res?.success) {
                showToast("Bot joined group successfully!");
                document.getElementById('invite-code-input').value = '';
                loadGroups();
            }
        }

        async function leaveGroup(chatId) {
            const confirmed = await showConfirm("Have the bot leave this group?");
            if (confirmed) {
                await api('/api/admin/groups/leave', { chatId });
                showToast("Left group!");
                loadGroups();
            }
        }

        async function populateGroupDropdowns() {
            const groups = await api('/api/admin/groups');
            if (groups) {
                const sel = document.getElementById('sch-group');
                if (sel) sel.innerHTML = groups.map(g => `<option value="${g.id}">${g.name}</option>`).join('');
            }
        }

        async function loadScheduledSprints() {
            const sprints = await api('/api/admin/scheduled');
            const list = document.getElementById('scheduled-list');
            if (!sprints || sprints.length === 0) {
                list.innerHTML = `<div class="text-center py-6 text-slate-500 text-xs">No scheduled sprints.</div>`;
                return;
            }
            list.innerHTML = sprints.map(s => `
                <div class="flex items-center justify-between p-4 bg-white/5 rounded-xl border border-white/10">
                    <div>
                        <div class="font-bold text-sm text-white">${s.groupName}</div>
                        <div class="text-xs text-slate-400">${s.duration} mins • ${new Date(s.startTime).toLocaleString()}</div>
                    </div>
                    <button onclick="cancelScheduledSprint('${s.id}')" class="px-3 py-1.5 bg-red-500/20 text-red-400 rounded-lg text-xs font-bold hover:bg-red-500/30 transition">Cancel</button>
                </div>
            `).join('');
        }

        async function createScheduledSprint() {
            const groupId = document.getElementById('sch-group').value;
            const startTime = document.getElementById('sch-time').value;
            const duration = parseInt(document.getElementById('sch-duration').value, 10);

            if (!groupId || !startTime) return showToast("Please select group and start date/time", "error");

            const res = await api('/api/admin/scheduled/create', { groupId, startTime, duration });
            if (res?.success) {
                showToast("Sprint scheduled successfully!");
                loadScheduledSprints();
            } else {
                showToast(res?.error || "Failed to schedule sprint", "error");
            }
        }

        async function cancelScheduledSprint(id) {
            const confirmed = await showConfirm("Cancel this scheduled sprint?");
            if (confirmed) {
                await api('/api/admin/scheduled/cancel', { id });
                showToast("Schedule cancelled!");
                loadScheduledSprints();
            }
        }

        function previewBCImage(e) {
            const file = e.target.files[0];
            if (file) {
                document.getElementById('bc-img-name').innerText = file.name;
                const reader = new FileReader();
                reader.onload = (ev) => { bcImageBase64 = ev.target.result; };
                reader.readAsDataURL(file);
            }
        }

        async function sendBroadcast() {
            const msg = document.getElementById('bc-msg').value.trim();
            const tagAll = document.getElementById('bc-tag-all').checked;

            if (!msg && !bcImageBase64) return showToast("Please enter message or attach image", "error");

            const res = await api('/api/admin/broadcast', { message: msg, image: bcImageBase64, tagAll });
            if (res?.success) {
                showToast(`Broadcast delivered to ${res.count} groups!`);
                document.getElementById('bc-msg').value = '';
                document.getElementById('bc-tag-all').checked = false;
                document.getElementById('bc-img-name').innerText = '';
                bcImageBase64 = null;
            } else {
                showToast(res?.error || "Failed to send broadcast", "error");
            }
        }

        async function loadFeedback() {
            const data = await api('/api/admin/feedback');
            const list = document.getElementById('feedback-list');
            if (data && data.items) {
                if (data.items.length === 0) {
                    list.innerHTML = `<div class="text-center py-6 text-slate-500 text-xs">No feedback messages.</div>`;
                    return;
                }
                list.innerHTML = data.items.map(f => `
                    <div class="p-4 bg-white/5 rounded-xl space-y-1 ${f.isRead ? 'opacity-60' : 'border-l-4 border-emerald-500'}">
                        <div class="flex items-center justify-between text-xs font-bold">
                            <span class="text-white">${f.senderName || f.userId}</span>
                            <span class="text-slate-500 font-mono">${new Date(f.timestamp).toLocaleString()}</span>
                        </div>
                        <div class="text-xs text-slate-300 font-medium">${f.message}</div>
                    </div>
                `).join('');
            }
        }

        async function markAllFeedbackRead() {
            await api('/api/admin/feedback/read', { id: 'all' });
            showToast("Marked feedback as read");
            loadFeedback();
        }

        // Auto Login check
        if (adminPass) {
            document.getElementById('admin-pass').value = adminPass;
            login();
        }
    </script>

</body>
</html>