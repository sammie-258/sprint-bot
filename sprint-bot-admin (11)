<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SYSTEM INTERFACE — Sprint Bot Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Space Grotesk', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        void: '#020617',
                        panel: '#0a1220',
                        elevated: '#0f1a30',
                        neon: {
                            blue: '#38bdf8',
                            purple: '#a855f7',
                            green: '#22d3a0',
                            red: '#f43f5e'
                        }
                    },
                    boxShadow: {
                        'neon-blue': '0 0 15px rgba(56, 189, 248, 0.2)',
                        'neon-purple': '0 0 15px rgba(168, 85, 247, 0.2)',
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --accent: #38bdf8;
            --accent-glow: rgba(56, 189, 248, 0.25);
        }
        body {
            background-color: #020617;
            color: #e2e8f0;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }
        .system-panel {
            background: rgba(10, 18, 32, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(56, 189, 248, 0.1);
            position: relative;
            overflow: hidden;
        }
        .system-panel::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            opacity: 0.5;
        }
        .nav-item {
            position: relative;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .nav-item.active {
            color: #38bdf8;
            background: rgba(56, 189, 248, 0.05);
        }
        .nav-item.active::before {
            content: '';
            position: absolute;
            left: 0; top: 0; bottom: auto;
            width: 2px;
            background: #38bdf8;
            box-shadow: 0 0 10px #38bdf8;
        }
        @media (max-width: 768px) {
            .nav-item.active::before {
                left: 0; right: 0; top: 0; bottom: auto;
                width: auto; height: 2px;
            }
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .input-system {
            background: rgba(2, 6, 23, 0.6);
            border: 1px solid rgba(56, 189, 248, 0.2);
            color: white;
            transition: all 0.2s;
        }
        .input-system:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
            outline: none;
        }
        .btn-system {
            transition: all 0.2s;
            position: relative;
            overflow: hidden;
        }
        .btn-system:active { transform: scale(0.95); }
        .glow-blue { box-shadow: 0 0 15px rgba(56, 189, 248, 0.3); }
        .glow-purple { box-shadow: 0 0 15px rgba(168, 85, 247, 0.3); }
        
        @keyframes scanline {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(100%); }
        }
        .scanline {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, transparent 50%, rgba(56, 189, 248, 0.02) 50%);
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 10;
        }
    </style>
</head>
<body class="font-sans antialiased">
    <div class="scanline"></div>

    <!-- Auth Modal -->
    <div id="auth-modal" class="fixed inset-0 bg-void/95 z-[100] flex items-center justify-center p-4">
        <div class="system-panel p-8 w-full max-w-md animate-in fade-in zoom-in duration-300">
            <div class="text-center mb-8">
                <div class="w-16 h-16 border-2 border-neon-blue rounded-full flex items-center justify-center mx-auto mb-4 glow-blue">
                    <i class="fas fa-shield-halved text-2xl text-neon-blue"></i>
                </div>
                <h1 class="font-heading font-bold text-2xl tracking-tighter">SYSTEM AUTHENTICATION</h1>
                <p class="text-slate-500 text-sm mt-1">Verify Shadow Monarch credentials</p>
            </div>
            <div class="space-y-4">
                <input type="password" id="admin-pass" placeholder="ENTER ACCESS KEY" 
                    class="input-system w-full px-6 py-4 rounded-xl font-mono text-center tracking-[0.5em]">
                <button onclick="login()" class="w-full py-4 bg-neon-blue text-void font-heading font-black rounded-xl hover:bg-white transition-colors duration-300">
                    ACCESS SYSTEM
                </button>
            </div>
        </div>
    </div>

    <div id="app" class="hidden min-h-screen flex flex-col md:flex-row">
        
        <!-- Sidebar (Desktop) / Bottom Nav (Mobile) -->
        <nav class="fixed bottom-0 left-0 right-0 md:relative md:w-64 bg-panel border-t md:border-t-0 md:border-r border-white/5 z-50 flex md:flex-col justify-around md:justify-start px-2 py-2 md:px-0 md:py-8 no-scrollbar overflow-x-auto">
            <div class="hidden md:flex items-center gap-3 px-6 mb-12">
                <div class="w-10 h-10 bg-neon-blue rounded flex items-center justify-center text-void">
                    <i class="fas fa-bolt-lightning text-xl"></i>
                </div>
                <div>
                    <div class="font-heading font-black text-lg tracking-tighter leading-none">SYSTEM</div>
                    <div class="text-[10px] text-neon-blue font-bold tracking-[0.2em]">COMMAND</div>
                </div>
            </div>

            <div class="flex md:flex-col gap-1 w-full px-2">
                <button onclick="switchTab('overview')" id="nav-overview" class="nav-item flex flex-col md:flex-row items-center gap-1 md:gap-4 px-4 md:px-6 py-3 md:py-4 rounded-xl flex-1 md:flex-none">
                    <i class="fas fa-chart-line text-lg"></i>
                    <span class="text-[10px] md:text-sm font-bold md:font-semibold uppercase tracking-wider md:tracking-normal">Status</span>
                </button>
                <button onclick="switchTab('sprints')" id="nav-sprints" class="nav-item flex flex-col md:flex-row items-center gap-1 md:gap-4 px-4 md:px-6 py-3 md:py-4 rounded-xl flex-1 md:flex-none">
                    <i class="fas fa-clock text-lg"></i>
                    <span class="text-[10px] md:text-sm font-bold md:font-semibold uppercase tracking-wider md:tracking-normal">Sprints</span>
                </button>
                <button onclick="switchTab('broadcast')" id="nav-broadcast" class="nav-item flex flex-col md:flex-row items-center gap-1 md:gap-4 px-4 md:px-6 py-3 md:py-4 rounded-xl flex-1 md:flex-none">
                    <i class="fas fa-tower-broadcast text-lg"></i>
                    <span class="text-[10px] md:text-sm font-bold md:font-semibold uppercase tracking-wider md:tracking-normal">Blast</span>
                </button>
                <button onclick="switchTab('writers')" id="nav-writers" class="nav-item flex flex-col md:flex-row items-center gap-1 md:gap-4 px-4 md:px-6 py-3 md:py-4 rounded-xl flex-1 md:flex-none">
                    <i class="fas fa-users-viewfinder text-lg"></i>
                    <span class="text-[10px] md:text-sm font-bold md:font-semibold uppercase tracking-wider md:tracking-normal">Writers</span>
                </button>
                <button onclick="switchTab('system')" id="nav-system" class="nav-item flex flex-col md:flex-row items-center gap-1 md:gap-4 px-4 md:px-6 py-3 md:py-4 rounded-xl flex-1 md:flex-none">
                    <i class="fas fa-microchip text-lg"></i>
                    <span class="text-[10px] md:text-sm font-bold md:font-semibold uppercase tracking-wider md:tracking-normal">System</span>
                </button>
            </div>

            <div class="hidden md:block mt-auto px-6 space-y-4">
                <div class="p-4 rounded-xl bg-white/5 border border-white/10">
                    <div class="text-[10px] text-slate-500 font-bold uppercase mb-2">Connected Device</div>
                    <div class="text-xs font-semibold flex items-center gap-2" id="device-info">
                        <span class="w-2 h-2 rounded-full bg-neon-green"></span> WhatsApp Bot
                    </div>
                </div>
                <button onclick="logout()" class="w-full flex items-center gap-4 px-4 py-3 text-neon-red hover:bg-neon-red/10 rounded-xl transition-all">
                    <i class="fas fa-power-off"></i> <span class="font-bold text-sm">LOGOUT</span>
                </button>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="flex-1 p-4 md:p-8 pb-24 md:pb-8 overflow-y-auto max-h-screen">
            
            <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                    <h2 id="view-title" class="font-heading font-black text-3xl tracking-tighter uppercase italic">Overview</h2>
                    <p id="view-desc" class="text-slate-500 text-sm">Real-time system telemetry</p>
                </div>
                <div class="flex items-center gap-3">
                    <button onclick="refreshData()" class="w-10 h-10 system-panel rounded-full flex items-center justify-center hover:text-neon-blue transition-colors">
                        <i class="fas fa-rotate"></i>
                    </button>
                    <div class="px-4 py-2 system-panel rounded-xl flex items-center gap-2 text-xs font-bold">
                        <span class="w-2 h-2 rounded-full animate-pulse bg-neon-blue"></span> LIVE STATS
                    </div>
                </div>
            </header>

            <!-- VIEWS -->
            
            <!-- OVERVIEW -->
            <div id="view-overview" class="space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="system-panel p-6 rounded-2xl group hover:border-neon-blue transition-all">
                        <div class="text-xs font-bold text-slate-500 uppercase mb-4 flex justify-between">
                            Total Words <i class="fas fa-pen-nib group-hover:text-neon-blue"></i>
                        </div>
                        <div class="text-3xl font-mono font-bold" id="stat-total-words">0</div>
                    </div>
                    <div class="system-panel p-6 rounded-2xl group hover:border-neon-purple transition-all">
                        <div class="text-xs font-bold text-slate-500 uppercase mb-4 flex justify-between">
                            Writers <i class="fas fa-user-edit group-hover:text-neon-purple"></i>
                        </div>
                        <div class="text-3xl font-mono font-bold" id="stat-total-writers">0</div>
                    </div>
                    <div class="system-panel p-6 rounded-2xl group hover:border-neon-green transition-all">
                        <div class="text-xs font-bold text-slate-500 uppercase mb-4 flex justify-between">
                            Groups <i class="fas fa-users-rectangle group-hover:text-neon-green"></i>
                        </div>
                        <div class="text-3xl font-mono font-bold" id="stat-total-groups">0</div>
                    </div>
                    <div class="system-panel p-6 rounded-2xl group hover:border-neon-red transition-all">
                        <div class="text-xs font-bold text-slate-500 uppercase mb-4 flex justify-between">
                            Active Sprints <i class="fas fa-fire group-hover:text-neon-red"></i>
                        </div>
                        <div class="text-3xl font-mono font-bold" id="stat-active-sprints">0</div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 system-panel p-6 rounded-2xl">
                        <h3 class="font-heading font-bold text-lg mb-6 flex items-center gap-2">
                            <i class="fas fa-wave-square text-neon-blue"></i> RECENT ACTIVITY
                        </h3>
                        <div id="activity-feed" class="space-y-4 max-h-[400px] overflow-y-auto pr-2 no-scrollbar">
                            <!-- Activity items -->
                        </div>
                    </div>
                    <div class="system-panel p-6 rounded-2xl">
                        <h3 class="font-heading font-bold text-lg mb-6 flex items-center gap-2">
                            <i class="fas fa-crown text-neon-purple"></i> DAILY MVPs
                        </h3>
                        <div id="daily-mvps" class="space-y-4">
                            <!-- MVP items -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- SPRINTS -->
            <div id="view-sprints" class="hidden space-y-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h3 class="font-heading font-bold text-lg mb-6 flex items-center gap-2">
                            <i class="fas fa-bolt text-neon-blue"></i> ACTIVE NOW
                        </h3>
                        <div id="sprints-active-list" class="space-y-4">
                            <!-- Active sprints -->
                        </div>
                    </div>
                    <div>
                        <h3 class="font-heading font-bold text-lg mb-6 flex items-center gap-2 text-slate-500">
                            <i class="fas fa-calendar-alt"></i> SCHEDULED
                        </h3>
                        <div id="sprints-scheduled-list" class="space-y-4">
                            <!-- Scheduled sprints -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- BROADCAST -->
            <div id="view-broadcast" class="hidden space-y-6">
                <div class="system-panel p-8 rounded-2xl max-w-4xl mx-auto">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <div class="space-y-6">
                            <h3 class="font-heading font-bold text-xl mb-4 flex items-center gap-3">
                                <i class="fas fa-paper-plane text-neon-blue"></i> NEW BROADCAST
                            </h3>
                            
                            <textarea id="bc-message" rows="5" class="input-system w-full p-4 rounded-xl text-sm leading-relaxed" placeholder="Enter transmission message..."></textarea>
                            
                            <div class="relative group">
                                <input type="file" id="bc-image" class="hidden" onchange="previewBCImage(event)">
                                <label for="bc-image" id="bc-preview-label" class="flex flex-col items-center justify-center p-8 border-2 border-dashed border-white/10 rounded-xl cursor-pointer hover:border-neon-blue transition-all">
                                    <i class="fas fa-image text-3xl text-slate-600 mb-2"></i>
                                    <span class="text-xs font-bold text-slate-500">ATTACH IMAGE (OPTIONAL)</span>
                                </label>
                                <div id="bc-preview-container" class="hidden relative rounded-xl overflow-hidden">
                                    <img id="bc-preview-img" class="w-full h-48 object-cover">
                                    <button onclick="removeBCImage()" class="absolute top-2 right-2 w-8 h-8 bg-neon-red/80 rounded-full flex items-center justify-center"><i class="fas fa-times"></i></button>
                                </div>
                            </div>

                            <button id="btn-transmit" onclick="transmitBroadcast()" class="w-full py-4 bg-neon-blue text-void font-heading font-black rounded-xl glow-blue flex items-center justify-center gap-3">
                                <i class="fas fa-radio"></i> INITIATE TRANSMISSION
                            </button>
                        </div>

                        <div class="space-y-4">
                            <div class="flex items-center justify-between mb-2">
                                <h4 class="text-xs font-black text-slate-500 uppercase tracking-widest">Target Groups</h4>
                                <label class="flex items-center gap-2 cursor-pointer group">
                                    <span class="text-[10px] font-bold text-slate-500 group-hover:text-neon-blue">SELECT ALL</span>
                                    <input type="checkbox" id="bc-select-all" onchange="toggleSelectAllGroups(this.checked)" class="sr-only peer">
                                    <div class="w-4 h-4 border border-neon-blue rounded peer-checked:bg-neon-blue flex items-center justify-center transition-all">
                                        <i class="fas fa-check text-[10px] text-void opacity-0 peer-checked:opacity-100"></i>
                                    </div>
                                </label>
                            </div>
                            <div class="relative mb-4">
                                <i class="fas fa-search absolute left-3 top-3 text-slate-500 text-xs"></i>
                                <input type="text" onkeyup="filterGroups(this.value)" class="input-system w-full pl-8 pr-4 py-2 rounded-lg text-xs" placeholder="Search groups...">
                            </div>
                            <div id="bc-groups-list" class="space-y-2 max-h-[350px] overflow-y-auto pr-2 no-scrollbar">
                                <!-- Group items with checkboxes -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- WRITERS -->
            <div id="view-writers" class="hidden space-y-6">
                <div class="flex flex-col sm:flex-row gap-4 mb-8">
                    <div class="relative flex-1">
                        <i class="fas fa-search absolute left-4 top-4 text-slate-500"></i>
                        <input type="text" id="writer-search" onkeyup="searchWriters(this.value)" class="input-system w-full pl-12 pr-4 py-4 rounded-xl font-medium" placeholder="Search writers by name or ID...">
                    </div>
                </div>

                <div id="writers-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Writer cards -->
                </div>
            </div>

            <!-- SYSTEM -->
            <div id="view-system" class="hidden space-y-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                    <div class="system-panel p-8 rounded-2xl flex flex-col items-center text-center">
                        <h3 class="font-heading font-black text-xl mb-6 tracking-tighter uppercase italic text-neon-blue">Bot Connection</h3>
                        <div id="qr-container" class="bg-white p-4 rounded-xl mb-6 hidden">
                            <img id="qr-image" class="w-48 h-48">
                        </div>
                        <div id="connection-status" class="flex flex-col items-center">
                            <div class="w-20 h-20 rounded-full border-2 border-neon-green flex items-center justify-center text-neon-green mb-4 glow-green">
                                <i class="fas fa-link text-3xl"></i>
                            </div>
                            <span class="text-xl font-bold mb-2">SYSTEM ONLINE</span>
                            <p class="text-slate-500 text-sm">Bot is successfully linked to WhatsApp</p>
                        </div>
                    </div>

                    <div class="system-panel p-8 rounded-2xl">
                        <h3 class="font-heading font-black text-xl mb-6 tracking-tighter uppercase italic text-neon-purple">System Control</h3>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-4 bg-white/5 rounded-xl border border-white/5">
                                <div>
                                    <div class="font-bold">Maintenance Mode</div>
                                    <div class="text-xs text-slate-500">Disable all bot commands</div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="maintenance-toggle" onchange="toggleMaintenance(this.checked)" class="sr-only peer">
                                    <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-neon-purple"></div>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- Modals -->
    <div id="confirm-modal" class="hidden fixed inset-0 bg-void/90 z-[110] flex items-center justify-center p-4">
        <div class="system-panel p-8 w-full max-w-sm text-center">
            <h3 class="font-heading font-bold text-xl mb-2" id="confirm-title">SYSTEM PROMPT</h3>
            <p class="text-slate-500 text-sm mb-8" id="confirm-msg">Confirm requested action?</p>
            <div class="flex gap-3">
                <button onclick="closeConfirm()" class="flex-1 py-3 bg-white/5 border border-white/10 rounded-xl font-bold text-sm">CANCEL</button>
                <button id="confirm-yes-btn" class="flex-1 py-3 bg-neon-purple text-void font-heading font-black rounded-xl">CONFIRM</button>
            </div>
        </div>
    </div>

    <!-- Freeze Modal -->
    <div id="freeze-modal" class="hidden fixed inset-0 bg-void/90 z-[110] flex items-center justify-center p-4">
        <div class="system-panel p-8 w-full max-w-sm">
            <h3 class="font-heading font-bold text-xl mb-2">GRANT FREEZE</h3>
            <p class="text-slate-500 text-xs mb-6">User: <span id="freeze-user-name" class="text-neon-blue font-bold"></span></p>
            <input type="number" id="freeze-amount" value="1" min="1" max="10" class="input-system w-full px-4 py-3 rounded-xl font-mono text-xl mb-4">
            <button id="btn-grant-freeze" class="w-full py-4 bg-neon-blue text-void font-heading font-black rounded-xl">GRANT SHIELD</button>
            <button onclick="document.getElementById('freeze-modal').classList.add('hidden')" class="w-full py-3 text-slate-500 font-bold text-sm">CANCEL</button>
        </div>
    </div>

    <script>
        const API_URL = 'https://sprint-bot-9bll.onrender.com';
        let token = localStorage.getItem('admin_key');
        let currentTab = 'overview';
        let allGroups = [];
        let bcImageBase64 = null;

        function login() {
            const pass = document.getElementById('admin-pass').value;
            if (!pass) return showToast("Enter Access Key", "error");
            token = pass;
            localStorage.setItem('admin_key', pass);
            location.reload();
        }

        function logout() { localStorage.removeItem('admin_key'); location.reload(); }

        async function api(endpoint, body, method = 'POST') {
            const opts = { method, headers: { 'Content-Type': 'application/json', 'x-admin-password': token } };
            if (body) opts.body = JSON.stringify(body);
            try {
                const res = await fetch(`${API_URL}${endpoint}`, opts);
                if (res.status === 403) { logout(); return null; }
                return res.json();
            } catch (e) { return null; }
        }

        function switchTab(tab) {
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('[id^="view-"]').forEach(el => el.classList.add('hidden'));
            document.getElementById(`nav-${tab}`).classList.add('active');
            document.getElementById(`view-${tab}`).classList.remove('hidden');
            currentTab = tab;
            loadTabData();
        }

        function loadTabData() {
            if (currentTab === 'overview') loadOverview();
            if (currentTab === 'sprints') loadSprints();
            if (currentTab === 'broadcast') loadGroupsForBroadcast();
            if (currentTab === 'writers') loadWriters();
            if (currentTab === 'system') loadSystemInfo();
        }

        function refreshData() { loadTabData(); showToast("System Data Refreshed"); }

        async function loadOverview() {
            const data = await api('/api/stats', null, 'GET');
            if (!data) return;
            document.getElementById('stat-total-words').textContent = data.totalWords.toLocaleString();
            document.getElementById('stat-total-writers').textContent = data.totalWriters;
            document.getElementById('stat-total-groups').textContent = data.totalGroups;
            document.getElementById('stat-active-sprints').textContent = data.activeSprintsCount;

            const feed = document.getElementById('activity-feed');
            feed.innerHTML = data.recentActivity.map(a => `
                <div class="flex items-start gap-4 p-4 rounded-xl hover:bg-white/5">
                    <div class="text-lg">${a.icon || '📝'}</div>
                    <div><div class="text-sm font-semibold">${a.text}</div><div class="text-[10px] text-slate-500">${new Date(a.timestamp).toLocaleTimeString()}</div></div>
                </div>
            `).join('');
        }

        async function loadSprints() {
            const data = await api('/api/admin/sprints', null, 'GET');
            document.getElementById('sprints-active-list').innerHTML = data?.map(s => `
                <div class="system-panel p-5 rounded-2xl flex justify-between items-center">
                    <div><div class="font-bold text-sm">${s.name}</div><div class="text-[10px] text-neon-blue font-bold">${s.timeLeft}M LEFT</div></div>
                    <button onclick="stopSprint('${s.id}')" class="w-10 h-10 rounded-xl bg-neon-red/10 text-neon-red"><i class="fas fa-stop"></i></button>
                </div>
            `).join('') || '<p class="text-center py-12 text-slate-500">No active sprints</p>';
        }

        async function loadGroupsForBroadcast() {
            const data = await api('/api/admin/groups', null, 'GET');
            if (!data) return;
            allGroups = data.sort((a, b) => b.todayWords - a.todayWords);
            renderGroupsList();
        }

        function renderGroupsList(filter = '') {
            const list = document.getElementById('bc-groups-list');
            list.innerHTML = allGroups.filter(g => g.subject.toLowerCase().includes(filter.toLowerCase())).map(g => `
                <label class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5 cursor-pointer">
                    <div class="flex items-center gap-3 min-w-0">
                        <input type="checkbox" name="target-group" value="${g.groupId}" class="sr-only peer">
                        <div class="w-5 h-5 border-2 border-white/10 rounded peer-checked:bg-neon-blue peer-checked:border-neon-blue flex items-center justify-center">
                            <i class="fas fa-check text-[10px] text-void opacity-0 peer-checked:opacity-100"></i>
                        </div>
                        <div class="truncate text-xs font-bold">${g.subject}</div>
                    </div>
                </label>
            `).join('');
        }

        function filterGroups(val) { renderGroupsList(val); }
        function toggleSelectAllGroups(checked) { document.querySelectorAll('input[name="target-group"]').forEach(cb => cb.checked = checked); }

        function previewBCImage(e) {
            const reader = new FileReader();
            reader.onload = ev => {
                bcImageBase64 = ev.target.result;
                document.getElementById('bc-preview-img').src = bcImageBase64;
                document.getElementById('bc-preview-label').classList.add('hidden');
                document.getElementById('bc-preview-container').classList.remove('hidden');
            };
            reader.readAsDataURL(e.target.files[0]);
        }

        function removeBCImage() {
            bcImageBase64 = null;
            document.getElementById('bc-preview-label').classList.remove('hidden');
            document.getElementById('bc-preview-container').classList.add('hidden');
        }

        async function transmitBroadcast() {
            const msg = document.getElementById('bc-message').value;
            const selected = Array.from(document.querySelectorAll('input[name="target-group"]:checked')).map(cb => cb.value);
            if (!msg && !bcImageBase64) return showToast("Enter message or image", "error");
            const res = await api('/api/admin/broadcast', { message: msg, image: bcImageBase64, targetGroups: selected });
            if (res && res.success) { showToast(`Delivered to ${res.count} groups`); document.getElementById('bc-message').value = ''; removeBCImage(); }
        }

        async function loadWriters(query = '') {
            const data = await api('/api/admin/search', { query });
            document.getElementById('writers-grid').innerHTML = data?.map(u => `
                <div class="system-panel p-6 rounded-2xl">
                    <div class="font-bold text-sm mb-4">${u.name}</div>
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div class="p-3 bg-white/5 rounded-xl text-center"><div class="text-[9px] text-slate-500 font-bold">Total</div><div class="text-xs font-mono font-bold">${(u.trueTotal || u.totalWords).toLocaleString()}</div></div>
                        <div class="p-3 bg-white/5 rounded-xl text-center"><div class="text-[9px] text-slate-500 font-bold">Streak</div><div class="text-xs font-mono font-bold text-neon-green">${u.currentStreak || 0}🔥</div></div>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="openFreezeModal('${u.userId}', '${u.name}')" class="flex-1 py-2 bg-neon-blue/10 text-neon-blue text-[10px] font-black rounded-lg">FREEZE</button>
                        <button onclick="toggleBan('${u.userId}', ${u.isBanned})" class="px-4 py-2 ${u.isBanned ? 'bg-neon-green/10 text-neon-green' : 'bg-neon-red/10 text-neon-red'} text-[10px] font-black rounded-lg">${u.isBanned ? 'UNBAN' : 'BAN'}</button>
                    </div>
                </div>
            `).join('') || '<p class="text-center py-20 text-slate-500 text-sm col-span-full">Searching...</p>';
        }

        function searchWriters(val) { clearTimeout(window.searchTimer); window.searchTimer = setTimeout(() => loadWriters(val), 500); }

        async function loadSystemInfo() {
            const data = await api('/api/stats', null, 'GET');
            if (data.qrCode) { document.getElementById('qr-image').src = data.qrCode; document.getElementById('qr-container').classList.remove('hidden'); document.getElementById('connection-status').classList.add('hidden'); }
            else { document.getElementById('qr-container').classList.add('hidden'); document.getElementById('connection-status').classList.remove('hidden'); }
        }

        function openFreezeModal(uid, name) { document.getElementById('freeze-user-name').textContent = name; document.getElementById('freeze-modal').classList.remove('hidden'); document.getElementById('btn-grant-freeze').onclick = () => grantFreeze(uid); }

        async function grantFreeze(userId) {
            const amount = document.getElementById('freeze-amount').value;
            const res = await api('/api/admin/writers/freeze', { userId, amount });
            if (res && res.success) { showToast(`Granted ${amount} freeze(s)`); document.getElementById('freeze-modal').classList.add('hidden'); loadWriters(); }
        }

        function showToast(msg, type = 'success') {
            const t = document.createElement('div');
            t.className = `fixed top-8 left-1/2 -translate-x-1/2 px-6 py-3 rounded-xl border font-bold text-xs z-[200] ${type==='success'?'bg-panel border-neon-blue text-neon-blue':'bg-void border-neon-red text-neon-red'}`;
            t.textContent = msg; document.body.appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }

        function closeConfirm() { document.getElementById('confirm-modal').classList.add('hidden'); }

        if (token) { document.getElementById('auth-modal').classList.add('hidden'); document.getElementById('app').classList.remove('hidden'); switchTab('overview'); }
    </script>
</body>
</html>