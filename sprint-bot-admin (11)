    <script>
        const API_URL = 'https://sprint-bot-9bll.onrender.com';
        let token = localStorage.getItem('admin_key');
        let myChart = null; 
        let drawerChartInstance = null;
        let analyticsDayChart = null, analyticsHourChart = null;
        let currentWriters = [];
        let currentGroups = [];
        let selectedWriters = [];
        let sprintRefreshInterval = null;

        // --- Theme & Layout ---
        function initTheme() {
            if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
                updateThemeIcons(true);
            } else {
                document.documentElement.classList.remove('dark');
                updateThemeIcons(false);
            }
        }
        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.theme = 'light'; updateThemeIcons(false);
            } else {
                document.documentElement.classList.add('dark');
                localStorage.theme = 'dark'; updateThemeIcons(true);
            }
            if (window.lastChartData) renderChart(window.lastChartData);
        }
        function updateThemeIcons(isDark) {
            const icon = document.getElementById('theme-icon');
            if(icon) icon.className = isDark ? 'fas fa-sun text-yellow-500' : 'fas fa-moon opacity-50';
        }
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('mobile-overlay').classList.toggle('hidden');
        }
        initTheme();

        if (token) {
            document.getElementById('auth-modal').classList.add('hidden');
            document.getElementById('app').classList.remove('hidden');
            loadSystemStats();
            loadConnectionStatus();
            pollFeedback();
        }

        // --- Routing ---
        function switchTab(tabId) {
            ['overview', 'analytics', 'dashboard', 'sprints', 'groups', 'writers', 'broadcasts'].forEach(t => {
                document.getElementById(`view-${t}`)?.classList.add('hidden');
                const navBtn = document.getElementById(`nav-${t}`);
                if (navBtn) {
                    navBtn.classList.remove('panel-inset', 'text-emerald-500', 'dark:text-emerald-400');
                    navBtn.classList.add('opacity-70');
                }
            });

            document.getElementById(`view-${tabId}`).classList.remove('hidden');
            const activeNav = document.getElementById(`nav-${tabId}`);
            if (activeNav) {
                activeNav.classList.remove('opacity-70');
                activeNav.classList.add('panel-inset', 'text-emerald-500', 'dark:text-emerald-400');
            }

            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('mobile-overlay').classList.add('hidden');

            if (sprintRefreshInterval) clearInterval(sprintRefreshInterval);

            if (tabId === 'sprints') { loadSprints(); sprintRefreshInterval = setInterval(loadSprints, 30000); }
            if (tabId === 'groups') loadGroups();
            if (tabId === 'dashboard') loadVisualDashboard();
            if (tabId === 'writers') loadWritersGrid();
            if (tabId === 'overview') { loadSystemStats(); loadConnectionStatus(); }
            if (tabId === 'analytics') loadAnalyticsDashboard();
            if (tabId === 'broadcasts') loadScheduledBroadcasts();
        }
        switchTab('overview');

        // --- Auth ---
        function login() {
            const pass = document.getElementById('admin-pass').value;
            if (!pass) return showToast("Please enter a password", "error");
            token = pass; localStorage.setItem('admin_key', pass); location.reload();
        }
        function logout() { localStorage.removeItem('admin_key'); location.reload(); }

        // --- API Helper ---
        async function api(endpoint, body, method = 'POST') {
            const opts = { method, headers: { 'Content-Type': 'application/json', 'x-admin-password': token } };
            if (body) opts.body = JSON.stringify(body);
            try {
                const res = await fetch(`${API_URL}${endpoint}`, opts);
                if (res.status === 403) { showToast("Access Denied", "error"); logout(); return null; }
                return res.json();
            } catch(e) { return null; }
        }

        // --- Overview ---
        async function loadSystemStats() {
            const data = await api('/api/admin/system', null, 'GET');
            if (!data) return;
            document.getElementById('sys-uptime').innerText = Math.floor(data.uptime / 60) + 'm';
            document.getElementById('sys-mem').innerText = data.memory + ' MB';
            document.getElementById('sys-platform').innerText = data.platform || 'Linux';
            
            const btn = document.getElementById('maint-btn');
            const status = document.getElementById('maint-status');
            if (data.maintenance) {
                status.innerText = "ACTIVE";
                status.className = "text-[11px] font-black uppercase tracking-widest px-4 py-2 rounded-xl bg-orange-500 text-white shadow-inner w-full sm:w-auto text-center";
                btn.innerText = "Disable";
            } else {
                status.innerText = "OFF";
                status.className = "text-[11px] font-black uppercase tracking-widest px-4 py-2 rounded-xl panel text-emerald-500 w-full sm:w-auto text-center";
                btn.innerText = "Enable";
            }
            updateFeedbackBadge(data.unreadFeedback || 0);
        }

        async function loadConnectionStatus() {
            try {
                const res = await fetch(`${API_URL}/api/stats`);
                const data = await res.json();
                const container = document.getElementById('connection-container');
                if (data.isConnected) {
                    container.innerHTML = `<div class="w-20 h-20 rounded-[2rem] panel-inset flex items-center justify-center text-[#10b981] text-4xl mb-5 mx-auto"><i class="fab fa-whatsapp"></i></div><h3 class="text-xl font-black text-bold">Online</h3><p class="text-[10px] uppercase font-bold tracking-widest text-[#10b981] mt-2">Synced</p>`;
                } else if (data.qrCode) {
