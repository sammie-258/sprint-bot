<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sprint Bot Command Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                }
            }
        }
    </script>

    <style>
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in { animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
        
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #a3b1c6; border-radius: 10px; }
        .dark ::-webkit-scrollbar-thumb { background: #0f172a; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* ── PURE CLAYMORPHISM COLOR VARIABLES ── */
        :root {
            --bg-base: #e0e5ec;
            --shadow-drk: #a3b1c6;
            --shadow-lgt: #ffffff;
            --text-main: #475569;
            --text-bold: #1e293b;
        }

        .dark {
            --bg-base: #1e293b;
            --shadow-drk: #0f172a;
            --shadow-lgt: #2e3d54;
            --text-main: #94a3b8;
            --text-bold: #f1f5f9;
        }

        body { 
            background-color: var(--bg-base); 
            color: var(--text-main);
            transition: background-color 0.3s ease; 
        }
        
        h1, h2, h3, h4, h5, h6, .text-bold { color: var(--text-bold); }

        /* ── CLAY ELEMENTS ── */
        .panel {
            background-color: var(--bg-base);
            border-radius: 28px;
            box-shadow: 
                10px 10px 20px var(--shadow-drk), 
                -10px -10px 20px var(--shadow-lgt),
                inset 2px 2px 5px rgba(255,255,255,0.4),
                inset -3px -3px 7px rgba(0,0,0,0.03);
            border: none;
            transition: all 0.3s ease;
        }
        .dark .panel {
            box-shadow: 
                10px 10px 20px var(--shadow-drk), 
                -10px -10px 20px var(--shadow-lgt),
                inset 2px 2px 5px rgba(255,255,255,0.02),
                inset -3px -3px 7px rgba(0,0,0,0.2);
        }

        .panel-inset {
            background-color: var(--bg-base);
            border-radius: 20px;
            box-shadow: 
                inset 6px 6px 12px var(--shadow-drk), 
                inset -6px -6px 12px var(--shadow-lgt);
            border: none;
        }

        .btn-clay {
            background-color: var(--bg-base);
            border-radius: 14px;
            box-shadow: 
                5px 5px 10px var(--shadow-drk), 
                -5px -5px 10px var(--shadow-lgt),
                inset 1px 1px 2px rgba(255,255,255,0.5);
            color: var(--text-bold);
            font-weight: 700;
            transition: all 0.15s ease;
            cursor: pointer;
            border: none;
        }
        .dark .btn-clay {
            box-shadow: 
                5px 5px 10px var(--shadow-drk), 
                -5px -5px 10px var(--shadow-lgt),
                inset 1px 1px 2px rgba(255,255,255,0.05);
        }
        .btn-clay:active, .btn-clay.active {
            box-shadow: inset 4px 4px 8px var(--shadow-drk), inset -4px -4px 8px var(--shadow-lgt);
            color: #10b981;
        }

        .btn-clay-primary {
            background-color: #10b981;
            border-radius: 14px;
            color: white;
            font-weight: 700;
            box-shadow: 
                6px 6px 12px rgba(16, 185, 129, 0.4), 
                -6px -6px 12px rgba(255, 255, 255, 0.5),
                inset 2px 2px 4px rgba(255, 255, 255, 0.4),
                inset -2px -2px 4px rgba(0, 0, 0, 0.1);
            transition: all 0.15s ease;
            border: none;
        }
        .dark .btn-clay-primary {
            box-shadow: 
                6px 6px 12px rgba(0, 0, 0, 0.4), 
                -6px -6px 12px rgba(16, 185, 129, 0.15),
                inset 2px 2px 4px rgba(255, 255, 255, 0.2),
                inset -2px -2px 4px rgba(0, 0, 0, 0.2);
        }
        .btn-clay-primary:active { box-shadow: inset 4px 4px 8px rgba(0,0,0,0.2); }

        .btn-clay-danger {
            background-color: #ef4444;
            border-radius: 14px;
            color: white;
            font-weight: 700;
            box-shadow: 
                6px 6px 12px rgba(239, 68, 68, 0.3), 
                -6px -6px 12px rgba(255, 255, 255, 0.5),
                inset 2px 2px 4px rgba(255, 255, 255, 0.3);
            transition: all 0.15s ease;
            border: none;
        }
        .dark .btn-clay-danger {
            box-shadow: 
                6px 6px 12px rgba(0, 0, 0, 0.4), 
                -6px -6px 12px rgba(239, 68, 68, 0.15),
                inset 2px 2px 4px rgba(255, 255, 255, 0.2);
        }
        .btn-clay-danger:active { box-shadow: inset 4px 4px 8px rgba(0,0,0,0.2); }

        .input-clay {
            background-color: var(--bg-base);
            border-radius: 14px;
            border: none;
            box-shadow: inset 5px 5px 10px var(--shadow-drk), inset -5px -5px 10px var(--shadow-lgt);
            color: var(--text-bold);
            transition: box-shadow 0.2s ease;
        }
        .input-clay:focus { outline: none; box-shadow: inset 6px 6px 12px var(--shadow-drk), inset -6px -6px 12px var(--shadow-lgt); }

        /* Layout utilities */
        .drawer-right { transform: translateX(120%); transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .drawer-right.open { transform: translateX(0); }
        
        @media (max-width: 767px) {
            .sidebar-mobile { transform: translateX(-120%); transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
            .sidebar-mobile.open { transform: translateX(0); }
        }
    </style>
</head>
<body class="h-screen w-screen font-sans flex overflow-hidden selection:bg-emerald-500 selection:text-white p-3 md:p-6 gap-4 md:gap-6">

    <div id="auth-modal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center transition-opacity duration-300">
        <div class="panel p-10 max-w-sm w-full text-center mx-4">
            <div class="mb-6 inline-flex p-5 rounded-3xl bg-[#10b981] text-white shadow-[0_10px_20px_rgba(16,185,129,0.4)] text-3xl">
                <i class="fas fa-lock"></i>
            </div>
            <h2 class="text-2xl font-extrabold mb-2 text-bold">Admin Access</h2>
            <div class="relative mb-8 mt-6">
                <i class="fas fa-key absolute left-4 top-3.5 opacity-50"></i>
                <input type="password" id="admin-pass" placeholder="Enter Access Key" 
                    class="input-clay w-full pl-11 pr-4 py-3 text-sm"
                    onkeydown="if(event.key==='Enter') login()">
            </div>
            <button onclick="login()" class="btn-clay-primary w-full py-4 text-lg tracking-wide">
                Unlock <i class="fas fa-arrow-right ml-2"></i>
            </button>
        </div>
    </div>

    <div id="app" class="hidden flex-1 w-full h-full flex gap-4 md:gap-6 min-h-0">

        <div id="mobile-overlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden" onclick="toggleSidebar()"></div>

        <aside id="sidebar" class="panel fixed inset-y-3 left-3 z-50 w-64 flex flex-col flex-shrink-0 sidebar-mobile md:relative md:inset-auto md:w-72 md:h-full">
            <div class="h-24 flex items-center px-6 md:px-8 shrink-0">
                <div class="w-12 h-12 rounded-2xl bg-[#10b981] flex items-center justify-center text-white mr-4 shadow-[0_8px_16px_rgba(16,185,129,0.3)]">
                    <i class="fas fa-robot text-xl"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-xl leading-tight text-bold">Sprint Bot</h1>
                    <p class="text-[10px] text-emerald-500 font-bold tracking-widest mt-1">ADMIN V4.0</p>
                </div>
                <button class="ml-auto md:hidden text-lg opacity-50 hover:opacity-100" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
            </div>

            <nav class="flex-1 px-4 md:px-5 py-4 space-y-3 overflow-y-auto no-scrollbar min-h-0">
                <p class="px-4 text-[10px] font-bold uppercase tracking-widest opacity-40 mb-3 mt-2">Dashboards</p>
                
                <button onclick="switchTab('overview')" id="nav-overview" class="btn-clay w-full flex items-center gap-4 px-5 py-3.5 text-sm">
                    <i class="fas fa-home w-5 text-center"></i> Overview
                </button>
                <button onclick="switchTab('analytics')" id="nav-analytics" class="btn-clay w-full flex items-center gap-4 px-5 py-3.5 text-sm">
                    <i class="fas fa-chart-pie w-5 text-center"></i> Analytics
                </button>
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="btn-clay w-full flex items-center gap-4 px-5 py-3.5 text-sm">
                    <i class="fas fa-tv w-5 text-center"></i> Live Display
                </button>

                <p class="px-4 text-[10px] font-bold uppercase tracking-widest opacity-40 mb-3 mt-8">Management</p>
                
                <button onclick="switchTab('sprints')" id="nav-sprints" class="btn-clay w-full flex items-center gap-4 px-5 py-3.5 text-sm">
                    <i class="fas fa-stopwatch w-5 text-center"></i> Active Sprints
                </button>
                <button onclick="switchTab('writers')" id="nav-writers" class="btn-clay w-full flex items-center gap-4 px-5 py-3.5 text-sm">
                    <i class="fas fa-users w-5 text-center"></i> Writers
                </button>
                <button onclick="switchTab('groups')" id="nav-groups" class="btn-clay w-full flex items-center gap-4 px-5 py-3.5 text-sm">
                    <i class="fas fa-hashtag w-5 text-center"></i> Groups
                </button>
                <button onclick="switchTab('broadcasts')" id="nav-broadcasts" class="btn-clay w-full flex items-center gap-4 px-5 py-3.5 text-sm">
                    <i class="fas fa-calendar-alt w-5 text-center"></i> Scheduler
                </button>

                <p class="px-4 text-[10px] font-bold uppercase tracking-widest opacity-40 mb-3 mt-8">Comms</p>
                
                <button onclick="openBroadcast()" class="btn-clay w-full flex items-center gap-4 px-5 py-3.5 text-sm text-blue-500">
                    <i class="fas fa-bolt w-5 text-center"></i> Instant Blast
                </button>
                <button onclick="openFeedbackDrawer()" class="btn-clay w-full flex items-center justify-between px-5 py-3.5 mt-2 text-sm text-indigo-500">
                    <div class="flex items-center gap-4"><i class="fas fa-inbox w-5 text-center"></i> Feedback</div>
                    <span id="sidebar-feedback-badge" class="hidden bg-indigo-500 text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-inner">0</span>
                </button>
            </nav>

            <div class="p-6 shrink-0 flex gap-4">
                <button onclick="toggleTheme()" class="btn-clay flex-1 py-3.5 flex justify-center items-center text-lg">
                    <i id="theme-icon" class="fas fa-moon"></i>
                </button>
                <button onclick="logout()" class="btn-clay flex-1 py-3.5 flex justify-center items-center text-red-500 text-lg">
                    <i class="fas fa-power-off"></i>
                </button>
            </div>
        </aside>

        <main class="flex-1 flex flex-col h-full min-w-0 relative">
            
            <header class="md:hidden panel h-16 flex items-center justify-between px-4 shrink-0 mb-4">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-[#10b981] flex items-center justify-center text-white"><i class="fas fa-robot text-xs"></i></div>
                    <h1 class="font-extrabold text-bold">Sprint Bot</h1>
                </div>
                <button onclick="toggleSidebar()" class="btn-clay w-10 h-10 flex items-center justify-center"><i class="fas fa-bars"></i></button>
            </header>

            <div class="flex-1 overflow-y-auto no-scrollbar pb-10 min-h-0 px-2 md:px-4 pt-2">
                
                <div id="view-overview" class="space-y-8 animate-fade-in hidden">
                    <h2 class="text-3xl font-extrabold mb-2 text-bold px-2">System Overview</h2>
                    
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
                        <div class="panel p-6 md:p-8 flex flex-col justify-center items-center text-center">
                            <h3 class="font-bold text-[11px] uppercase tracking-widest opacity-50 mb-6">Bot Connection</h3>
                            <div id="connection-container">
                                <i class="fas fa-circle-notch fa-spin text-[#10b981] text-4xl mb-4"></i>
                                <p class="font-bold text-lg">Checking...</p>
                            </div>
                        </div>

                        <div class="panel p-6 md:p-8 lg:col-span-2 flex flex-col justify-between">
                            <div class="flex justify-between items-start mb-6">
                                <h3 class="font-bold text-[11px] uppercase tracking-widest opacity-50">System Telemetry</h3>
                                <span class="w-4 h-4 bg-[#10b981] rounded-full animate-pulse shadow-[0_0_12px_#10b981]"></span>
                            </div>
                            
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 w-full">
                                <div class="panel-inset p-4 flex flex-col items-center justify-center text-center overflow-hidden">
                                    <i class="fas fa-memory text-blue-500 text-xl md:text-2xl mb-2 md:mb-3 opacity-80"></i>
                                    <p class="text-[10px] font-bold uppercase tracking-widest opacity-50 mb-1">Memory</p>
                                    <p class="text-base sm:text-lg font-extrabold text-bold truncate w-full px-1" id="sys-mem">...</p>
                                </div>
                                <div class="panel-inset p-4 flex flex-col items-center justify-center text-center overflow-hidden">
                                    <i class="fas fa-clock text-purple-500 text-xl md:text-2xl mb-2 md:mb-3 opacity-80"></i>
                                    <p class="text-[10px] font-bold uppercase tracking-widest opacity-50 mb-1">Uptime</p>
                                    <p class="text-base sm:text-lg font-extrabold text-bold truncate w-full px-1" id="sys-uptime">...</p>
                                </div>
                                <div class="panel-inset p-4 flex flex-col items-center justify-center text-center overflow-hidden col-span-2 md:col-span-1">
                                    <i class="fas fa-server text-orange-500 text-xl md:text-2xl mb-2 md:mb-3 opacity-80"></i>
                                    <p class="text-[10px] font-bold uppercase tracking-widest opacity-50 mb-1">Server</p>
                                    <p class="text-base sm:text-lg font-extrabold text-bold truncate w-full px-1" id="sys-platform">...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="panel p-6 md:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
                        <div class="flex items-center gap-5">
                            <div class="w-14 h-14 rounded-2xl panel-inset flex items-center justify-center text-xl opacity-70 shrink-0"><i class="fas fa-tools"></i></div>
                            <div>
                                <h3 class="font-extrabold text-xl text-bold">Maintenance Mode</h3>
                                <p class="text-sm opacity-60 mt-1">Lock bot commands globally</p>
                            </div>
                        </div>
                        <div class="flex flex-col sm:flex-row items-center gap-4 panel-inset p-2 rounded-2xl w-full sm:w-auto">
                            <span id="maint-status" class="text-xs font-bold px-4 py-2 rounded-xl text-emerald-500 text-center w-full sm:w-auto">OFF</span>
                            <button onclick="toggleMaintenance()" id="maint-btn" class="btn-clay px-6 py-2.5 text-sm font-bold w-full sm:w-auto">Enable</button>
                        </div>
                    </div>
                </div>

                <div id="view-analytics" class="space-y-8 animate-fade-in hidden">
                    <h2 class="text-3xl font-extrabold mb-2 text-bold px-2">Analytics</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
                        <div class="panel p-8 text-center flex flex-col justify-center">
                            <h3 class="font-bold text-[10px] uppercase tracking-widest opacity-50 mb-3">Weekly Retention</h3>
                            <h2 class="text-5xl font-black text-blue-500 mb-2" id="analytics-retention">0%</h2>
                            <p class="text-xs font-bold opacity-40">vs last week</p>
                        </div>
                        <div class="panel p-8 text-center flex flex-col justify-center">
                            <h3 class="font-bold text-[10px] uppercase tracking-widest opacity-50 mb-3">Active (7 Days)</h3>
                            <h2 class="text-5xl font-black text-emerald-500" id="analytics-active-week">0</h2>
                        </div>
                        <div class="panel p-8 text-center flex flex-col justify-center">
                            <h3 class="font-bold text-[10px] uppercase tracking-widest opacity-50 mb-3">Active (Prev 7)</h3>
                            <h2 class="text-5xl font-black opacity-40" id="analytics-active-prev">0</h2>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
                        <div class="panel p-6 md:p-8">
                            <h3 class="font-extrabold text-lg mb-6 text-bold">Word Velocity (30 Days)</h3>
                            <div class="panel-inset p-4 h-72 w-full"><canvas id="chart-velocity"></canvas></div>
                        </div>
                        <div class="panel p-6 md:p-8">
                            <h3 class="font-extrabold text-lg mb-6 text-bold">Active Hours (30 Days)</h3>
                            <div class="panel-inset p-4 h-72 w-full"><canvas id="chart-hours"></canvas></div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 pb-10">
                        <div class="panel p-6 md:p-8 flex flex-col">
                            <h3 class="font-extrabold text-lg mb-6 text-emerald-500"><i class="fas fa-arrow-trend-up mr-2"></i>Top Growers</h3>
                            <div class="panel-inset p-2 flex-1 overflow-y-auto max-h-72 no-scrollbar">
                                <table class="w-full text-left text-sm">
                                    <thead>
                                        <tr class="text-[10px] font-bold uppercase tracking-widest opacity-40">
                                            <th class="p-4">Writer</th><th class="p-4 text-right">Words</th><th class="p-4 text-right">Growth</th>
                                        </tr>
                                    </thead>
                                    <tbody id="analytics-growers"></tbody>
                                </table>
                            </div>
                        </div>
                        <div class="panel p-6 md:p-8 flex flex-col">
                            <h3 class="font-extrabold text-lg mb-6 text-purple-500"><i class="fas fa-chart-pie mr-2"></i>Group Breakdown</h3>
                            <div class="panel-inset p-2 flex-1 overflow-y-auto max-h-72 no-scrollbar">
                                <table class="w-full text-left text-sm">
                                    <thead>
                                        <tr class="text-[10px] font-bold uppercase tracking-widest opacity-40">
                                            <th class="p-4">Group</th><th class="p-4 text-right">Writers</th><th class="p-4 text-right">Words</th>
                                        </tr>
                                    </thead>
                                    <tbody id="analytics-groups"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="view-dashboard" class="space-y-8 animate-fade-in hidden">
                    <h2 class="text-3xl font-extrabold mb-2 text-bold px-2">Live Display</h2>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        <div class="panel p-6 text-center">
                            <p class="font-bold text-[10px] uppercase tracking-widest opacity-50 mb-2">Total Words</p>
                            <h2 class="text-3xl font-black text-bold" id="dash-total-words">0</h2>
                        </div>
                        <div class="panel p-6 text-center">
                            <p class="font-bold text-[10px] uppercase tracking-widest opacity-50 mb-2">Total Writers</p>
                            <h2 class="text-3xl font-black text-bold" id="dash-total-writers">0</h2>
                        </div>
                        <div class="panel p-6 text-center">
                            <p class="font-bold text-[10px] uppercase tracking-widest opacity-50 mb-2">Active Groups</p>
                            <h2 class="text-3xl font-black text-bold" id="dash-total-groups">0</h2>
                        </div>
                        <div class="panel p-6 text-center flex flex-col justify-center items-center">
                            <p class="font-bold text-[10px] uppercase tracking-widest opacity-50 mb-2">Bot Status</p>
                            <div class="panel-inset px-4 py-2 rounded-xl inline-flex items-center gap-2">
                                <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_#10b981]"></div>
                                <span class="text-sm font-black text-emerald-500" id="dash-status">ACTIVE</span>
                            </div>
                        </div>
                    </div>

                    <div class="panel p-6 md:p-8 relative overflow-hidden">
                        <div class="absolute top-0 left-0 w-2 h-full bg-[#10b981]"></div>
                        <div class="flex justify-between items-center mb-6 pl-2">
                            <h3 class="font-extrabold text-xl text-bold">Global Pulse <span class="opacity-40 text-sm ml-2 hidden sm:inline">(7 Days)</span></h3>
                            <span class="panel-inset px-3 py-1.5 rounded-lg text-[10px] font-black text-emerald-500 tracking-widest flex items-center gap-2 shrink-0"><i class="fas fa-broadcast-tower"></i> LIVE</span>
                        </div>
                        <div class="panel-inset p-4 h-80 w-full"><canvas id="activityChart"></canvas></div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8 pb-10">
                        <div class="panel p-6 flex flex-col h-[400px]">
                            <div class="flex items-center gap-3 mb-4 px-2">
                                <div class="w-10 h-10 panel-inset rounded-xl flex items-center justify-center text-yellow-500 text-lg"><i class="fas fa-trophy"></i></div>
                                <h3 class="font-extrabold text-bold text-lg">Hall of Fame</h3>
                            </div>
                            <div class="panel-inset p-2 flex-1 overflow-y-auto no-scrollbar">
                                <table class="w-full text-left text-sm"><tbody id="all-time-list"></tbody></table>
                            </div>
                        </div>
                        <div class="panel p-6 flex flex-col h-[400px]">
                            <div class="flex items-center gap-3 mb-4 px-2">
                                <div class="w-10 h-10 panel-inset rounded-xl flex items-center justify-center text-blue-500 text-lg"><i class="fas fa-fire"></i></div>
                                <h3 class="font-extrabold text-bold text-lg">Today's Top</h3>
                            </div>
                            <div class="panel-inset p-2 flex-1 overflow-y-auto no-scrollbar">
                                <table class="w-full text-left text-sm"><tbody id="today-list"></tbody></table>
                            </div>
                        </div>
