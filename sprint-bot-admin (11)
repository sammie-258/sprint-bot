                        <select id="writer-sort" onchange="loadWritersGrid()" class="bg-void border border-white/10 px-8 py-5 font-black text-xs uppercase tracking-widest outline-none"><option value="recent">RECENT</option><option value="words">WORDS</option><option value="name">NAME</option></select>
                    </div>
                    <div id="writers-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"></div>
                </div>

                <div id="view-groups" class="hidden space-y-8">
                    <div class="flex justify-between items-center mb-12"><h3 class="font-black italic text-2xl text-neon-green uppercase tracking-tighter">Guild Network</h3><button onclick="openJoinGroup()" class="bg-neon-green text-void px-8 py-3 font-black text-xs uppercase italic tracking-widest">Join New Node</button></div>
                    <div id="groups-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8"></div>
                </div>

                <div id="view-broadcast" class="hidden space-y-8">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                        <div class="hud-border p-10">
                            <h3 class="font-black italic text-xl text-neon-blue mb-8 uppercase">Transmission</h3>
                            <textarea id="bc-msg" rows="8" class="w-full bg-void/50 border border-white/10 p-6 mb-8 text-sm outline-none focus:border-neon-blue resize-none font-medium" placeholder="Payload..."></textarea>
                            <div id="bc-preview-cont" class="hidden mb-8 relative border border-white/10 p-1"><img id="bc-preview-img" class="w-full h-48 object-cover opacity-80"><button onclick="removeBCImage()" class="absolute top-4 right-4 bg-neon-red text-white w-10 h-10 flex items-center justify-center border border-white/20"><i class="fas fa-times"></i></button></div>
                            <div class="flex gap-6"><input type="file" id="bc-file" class="hidden" onchange="previewBCImage(event)"><label for="bc-file" class="flex-1 border border-white/10 py-4 text-center text-xs font-black tracking-widest uppercase cursor-pointer">LOAD IMAGE</label><button onclick="sendBroadcast()" class="flex-[1.5] bg-neon-blue text-void py-4 font-black italic tracking-widest uppercase">FIRE BLAST</button></div>
                        </div>
                        <div class="hud-border p-10 flex flex-col">
                            <div class="flex justify-between items-center mb-6"><h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Targets</h3><button onclick="toggleAllTargets()" class="text-[10px] font-black text-neon-blue uppercase">Toggle All</button></div>
                            <input type="text" onkeyup="filterBCGroups(this.value)" class="bg-void border border-white/10 px-4 py-3 text-xs outline-none focus:border-neon-blue mb-6 font-bold uppercase" placeholder="Search targets...">
                            <div id="bc-groups-list" class="flex-1 space-y-3 overflow-y-auto no-scrollbar max-h-[450px]"></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
